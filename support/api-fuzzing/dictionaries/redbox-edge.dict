# ReDBox Fuzzing Dictionary
# Mutation values for API fuzzing

# String mutations
""
" "
"  "
"\t"
"\n"
"\r\n"
"null"
"undefined"
"NaN"
"Infinity"
"-Infinity"
"[]"
"{}"
"[object Object]"

# ID mutations
"00000000-0000-0000-0000-000000000000"
"ffffffff-ffff-ffff-ffff-ffffffffffff"
"nonexistent-id-here"
"../../../etc/passwd"
"__proto__"
"constructor"
"prototype"
"<script>alert(1)</script>"
"{{constructor.constructor('return process')().env}}"

# Date mutations
"0000-00-00"
"9999-99-99"
"1969-12-31"
"2038-01-19"
"9999-12-31T23:59:59.999Z"
"0000-00-00T00:00:00.000Z"
"not-a-date"
"NaN-NaN-NaN"
"01/01/1970"
"2021-02-29"
"2021-13-01"

# Query payload mutations
"{ $gt: '' }"
"{ $ne: '' }"
"{ $where: '1' }"
"{ $regex: '.*' }"
"{ $exists: true }"
"{ $in: ['admin', 'root'] }"

# Role name mutations
"admin"
"ADMIN"
"Administrator"
"system"
"root"
"superuser"
"librarian"
"LIBRARIAN"
"researcher"
"' OR '1'='1"
"admin'--"
"nonexistent-role"

# Record type mutations
"rdmp"
"RDMP"
"dataPublication"
"dataRecord"
"party"
"nonexistent"
""
"*"
"__all__"

# Lucene/Solr-ish search strings
"*:*"
"*"
"?"
"+"
"-"
"&&"
"||"
"!"
"("
")"
"{"
"}"
"["
"]"
"^"
"~"
":"
"\""
"\\"
"0"
"AND"
"OR"
"NOT"
"title:*"
"*:* AND *:*"
"title:({ $gt: '' })"

# HTML/script-like text
"<script>alert('xss')</script>"
"<img src=x onerror=alert(1)>"
"<svg onload=alert(1)>"
"<a href='javascript:alert(1)'>click</a>"
"javascript:alert(1)"
"data:text/html,<script>alert(1)</script>"
"%3Cscript%3Ealert(1)%3C/script%3E"
"'+alert(1)+'"
"${alert(1)}"
"{{alert(1)}}"

# Long values (edge cases)
"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

