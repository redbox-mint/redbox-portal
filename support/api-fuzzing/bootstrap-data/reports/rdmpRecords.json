{
  "title": "Fuzz RDMP Records",
  "reportSource": "database",
  "databaseQuery": {
    "queryName": "listRDMPRecords"
  },
  "filter": [
    {
      "paramName": "title",
      "type": "text",
      "property": "title",
      "label": "Title"
    },
    {
      "paramName": "dateCreatedRange",
      "type": "date-range",
      "startProperty": "dateCreated",
      "endProperty": "dateCreated",
      "label": "Date Created"
    },
    {
      "paramName": "dateModifiedRange",
      "type": "date-range",
      "startProperty": "dateModified",
      "endProperty": "dateModified",
      "label": "Date Modified"
    }
  ],
  "columns": [
    {
      "label": "Id",
      "property": "oid",
      "hide": true
    },
    {
      "label": "Title",
      "property": "title",
      "template": "<a href='/default/rdmp/record/{{oid}}'>{{title}}</a>"
    },
    {
      "label": "Chief Investigator",
      "property": "contributor_ci"
    },
    {
      "label": "Date Modified",
      "property": "dateModified"
    },
    {
      "label": "Date Created",
      "property": "dateCreated"
    }
  ]
}
