{
  "collectionName": "record",
  "brandIdFieldPath": "metaMetadata.brandId",
  "resultObjectMapping": {
    "oid": "{{record.redboxOid}}",
    "title": "{{record.metadata.title}}",
    "description": "{{record.metadata.description}}",
    "keywords": "{{record.metadata.finalKeywords}}",
    "contributor_ci": "{{record.metadata.contributor_ci.text_full_name}}",
    "contributor_data_manager": "{{record.metadata.contributor_data_manager.text_full_name}}",
    "dateCreated": "{{record.dateCreated}}",
    "dateModified": "{{record.lastSaveDate}}"
  },
  "mongoQuery": {
    "metaMetadata.type": "rdmp"
  },
  "sort": [{ "lastSaveDate": "DESC" }],
  "queryParams": {
    "title": {
      "type": "string",
      "path": "metadata.title",
      "queryType": "contains",
      "whenUndefined": "ignore"
    },
    "dateCreatedBefore": {
      "type": "string",
      "path": "dateCreated",
      "queryType": "<=",
      "whenUndefined": "ignore"
    },
    "dateCreatedAfter": {
      "type": "string",
      "path": "dateCreated",
      "queryType": ">=",
      "whenUndefined": "ignore"
    },
    "dateModifiedBefore": {
      "type": "string",
      "path": "lastSaveDate",
      "queryType": "<=",
      "whenUndefined": "ignore"
    },
    "dateModifiedAfter": {
      "type": "string",
      "path": "lastSaveDate",
      "queryType": ">=",
      "whenUndefined": "ignore"
    }
  }
}
