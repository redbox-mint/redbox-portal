  "circleJobs": {
    "test": {
      "machine": {
        "image": "ubuntu-2404:current"
      },
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Run  unit tests",
            "command": "bash support/build/test.sh"
          }
        },
        {
          "run": {
            "name": "Run integration tests",
            "command": "docker compose -f support/v6/docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from rbportal"
          }
        },
        {
          "run": {
            "name": "Clean up integration test containers",
            "command": "docker compose -f support/v6/docker-compose.test.yml down -v --remove-orphans --timeout 180 || true",
            "when": "always"
          }
        }
      ]
    },
    "deploy": {
      "machine": {
        "image": "ubuntu-2404:current"
      },
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Build and deploy",
            "command": "chmod +x support/build/nexus_deploy.sh support/build/docker-build-vars.sh && support/build/nexus_deploy.sh linux/amd64 -amd64"
          }
        }
      ]
    },
    "deploy-arm64": {
      "machine": {
        "image": "ubuntu-2404:current"
      },
      "resource_class": "arm.medium",
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Build arm64 image",
            "command": "chmod +x support/build/nexus_deploy.sh support/build/docker-build-vars.sh && support/build/nexus_deploy.sh linux/arm64 -arm64"
          }
        }
      ]
    },
    "publish-manifest": {
      "machine": {
        "image": "ubuntu-2404:current"
      },
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Publish multi-arch manifest",
            "command": "chmod +x support/build/nexus_publish_manifest.sh support/build/docker-build-vars.sh && support/build/nexus_publish_manifest.sh"
          }
        }
      ]
    },
    "local": {
      "machine": {
        "image": "ubuntu-2404:current"
      },
      "steps": [
        "checkout",
        {
          "run": {
            "name": "Build locally",
            "command": "chmod +x support/build/build_local.sh support/build/docker-build-vars.sh && support/build/build_local.sh"
          }
        }
      ]
    }
  },
  "circleRunSteps": [
    {
      "job": "test",
