  "npmScripts": {
    "compile": "node ./node_modules/@researchdatabox/redbox-dev-tools/bin/run-hook-tsc.js -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run compile && TS_NODE_PROJECT=./test/tsconfig.json TS_NODE_TRANSPILE_ONLY=true node ./node_modules/@researchdatabox/redbox-dev-tools/bin/run-hook-mocha.js --config ./test/unit/.mocharc.cjs ./test/unit",
    "test:integration:mocha": "npm run test:integration",
    "test:integration:mocha:clean": "npm run test:integration:clean",
    "dev:run:prepare": "mkdir -p ./support/development/.tmp/attachments/staging ./support/development/.tmp/mongo ./support/development/.tmp/seaweedfs/data ./support/development/.tmp/publications && npm run compile",
    "dev:run": "npm run dev:run:prepare && docker compose -f ./support/development/docker-compose.yml up --menu=false --abort-on-container-exit --exit-code-from rbportal",
    "dev:run:build": "docker compose -f ./support/development/docker-compose.yml build",
    "dev:run:clean": "docker compose -f ./support/development/docker-compose.yml down -v --remove-orphans --timeout 180",
    "dev:run:core:prepare": "bash ./support/development/prepare-core-mount.sh",
    "dev:run:core": "bash ./support/development/prepare-core-mount.sh",
    "dev:run:core:clean": "bash ./support/development/prepare-core-mount.sh",
    "build": "node ./node_modules/@researchdatabox/redbox-dev-tools/bin/run-hook-tsc.js -p tsconfig.json",
    "test:integration": "docker compose -f support/v6/docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from rbportal",
    "test:integration:clean": "docker compose -f support/v6/docker-compose.test.yml down -v --remove-orphans --timeout 180",
    "dev:run:indexes:inspect": "npm run dev:run:prepare && docker compose -f ./support/development/docker-compose.yml run --rm rbportal node node_modules/redbox-hook-wsu/support/v6/app.cjs --maintenance=indexes:inspect",
    "dev:run:indexes:ensure": "npm run dev:run:prepare && docker compose -f ./support/development/docker-compose.yml run --rm rbportal node node_modules/redbox-hook-wsu/support/v6/app.cjs --maintenance=indexes:ensure"
  },
