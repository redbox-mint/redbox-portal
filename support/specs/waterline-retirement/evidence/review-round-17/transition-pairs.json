    "ordered_save": {
      "outcome": "Snapshot submission, then serialize with preceding save/release. Retain owned record for renewal; acknowledged lockless completion/retry ends it. Ambiguous/nonterminal failure retains it. Confirmed ownership/receipt loss ends it.",
