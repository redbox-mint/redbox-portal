        "AgendaQueueService/ended and AccessDenied state-save errors"
      ]
    },
    "expired_save": {
      "outcome": "Local elapsed expiry is not permission to delete ownership. With no successor Mongo may still save its own lock; with a successor its owner predicate misses and ends only the old record. SQS ended-receipt errors end only that receipt; ambiguous errors remain owned.",
      "code": [
        "Mongo owned predicate",
        "ownAgendaRepository/saveJobState catch",
        "receiptEnded"
      ],
      "witnesses": [
