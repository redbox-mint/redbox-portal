  "backendDifferences": {
    "mongodb": "Persisted unique per-acquisition lastModifiedBy fences both state save and release. Heartbeat timestamps remain normal lease clocks, not retained candidate identities.",
    "sqs": "AWS receipt handle identifies delivery. Exact terminal errors end only that receipt. Stale DeleteMessage may acknowledge without affecting a newer receipt."
  },
  "semantics": "Each row follows one target delivery. claim/redelivery can introduce another independent delivery; later stale operations still use their captured target. completion/retry_save/release mean acknowledged success; release_retry includes retained failure and successful/ended outcomes, handled conditionally. drain_deadline is an application overlay, including already-admitted late acquisitions.",
  "rules": {
    "new_delivery": {
      "outcome": "New acquisition has an independent delivery key; old owner/acknowledgement cannot remove or release it. Open admission is required. An already-admitted late receive is owned and immediately released.",
      "code": [
        "ownAgendaRepository/acquiring",
        "releaseClaim"
      ],
      "witnesses": [
