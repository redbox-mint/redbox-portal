meta {
  name: Create HARVEST Record
  type: http
  seq: 1
}

post {
  url: {{host}}/default/rdmp/api/records/harvest/rdmp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

script:pre-request {
  // Generate a unique harvestId per run to avoid collisions with previous data
  var unique = Date.now().toString().slice(-10);
  var hid = 'h' + unique;
  bru.setEnvVar('harvestId', hid);
  bru.setEnvVar('harvestSourceRunId', 'source-run-' + unique);
  bru.setEnvVar('harvestSourceName', 'source-' + unique);
}

body:json {
  {
    "records": [
        {
            "harvestId": "{{harvestId}}",
            "recordRequest": {
                "metadata": {
                    "ID": "{{harvestId}}",
                    "GIVEN_NAME": "Ant",
                    "OTHER_NAMES": "",
                    "FAMILY_NAME": "S",
                    "PREF_NAME": "",
                    "HONORIFIC": "",
                    "EMAIL": "notAReal@email.edu.au",
                    "JOB_TITLE": "Assistant Professor",
                    "URI": "",
                    "NLA_PARTY_IDENTIFIER": "",
                    "ORCID": "0000-0001-7269-2286",
                    "PERSONAL_HOMEPAGE": "",
                    "STAFF_PROFILE_HOMEPAGE": "",
                    "DESCRIPTION": "",
                    "RESEARCH_ELEMENTS_USER_ID": "12345678",
                    "title": "Mock mint record type rdmp integration test",
                    "contributor_ci": {
                        "text_full_name": "Prof Ant Season",
                        "email": "notAReal@email.edu.au",
                        "orcid": "http://orcid.org/0000-0000-0000-000"
                    },
                    "contributor_data_manager": {
                        "text_full_name": "Prof Ant Season",
                        "email": "notAReal@email.edu.au",
                        "orcid": "http://orcid.org/0000-0000-0000-000"
                    }
                }
            }
        }
    ],
    "sourceRunId": "{{harvestSourceRunId}}",
    "sourceName": "{{harvestSourceName}}",
    "finalChunk": true,
    "chunk": {
      "index": 0,
      "label": "create-harvest-record"
    }
  }
}

tests {
  
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Test harvest run exists", function () {
        var body = res.getBody();
        expect(body).to.have.property('run');
        expect(body.run).to.have.property('sourceRunId', bru.getEnvVar('harvestSourceRunId'));
        expect(body.run).to.have.property('sourceName', bru.getEnvVar('harvestSourceName'));
  });
  
  test("Test harvest chunk summary is as expected", function () {
    var body = res.getBody();
    expect(body).to.have.property('chunk');
    expect(body.chunk).to.have.property('sourceRunId', bru.getEnvVar('harvestSourceRunId'));
    expect(body.chunk).to.have.property('recordCount', 1);
    expect(body.chunk).to.have.property('totalProcessed', 1);
    expect(body.chunk).to.have.property('created', 1);
    expect(body.chunk).to.have.property('failed', 0);
  });
  
}
