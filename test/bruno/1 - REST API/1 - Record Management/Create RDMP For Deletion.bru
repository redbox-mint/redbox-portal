meta {
  name: Create Strict Record For Deletion
  type: http
  seq: 20
}

post {
  url: {{host}}/default/rdmp/api/records/metadata/concurrencyTest
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
      "title": "Strict concurrency lifecycle fixture",
      "authorization": []
  }
}

tests {
  
  test("Status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
      const etag = res.getHeader("etag");
      expect(etag).to.match(/^".+"$/);
      bru.setEnvVar("strictLifecycleEtag", etag);
  });
  
  test("Test oid exists", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('oid');
      bru.setEnvVar("strictLifecycleOid", jsonData.oid);
  });
}
