meta {
  name: List Deleted Strict Lifecycle Records
  type: http
  seq: 23
}

get {
  url: {{host}}/default/rdmp/api/deletedrecords/list?recordType=concurrencyTest
  body: none
  auth: none
}

query {
  recordType: concurrencyTest
}

headers {
  Authorization: Bearer {{token}}
  ~: 
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("The isolated strict record is present", function () {
      var jsonData = res.getBody();
      expect(jsonData.records.some(record => record.oid === bru.getEnvVar("strictLifecycleOid"))).to.eql(true);
  });
  
  test("Check record has oid and metadata properties", function () {
      var jsonData = res.getBody();
      const record = jsonData.records.find(record => record.oid === bru.getEnvVar("strictLifecycleOid"));
      expect(record).to.have.property("oid")
      expect(record).to.have.property("deletedRecord")
  });
}
