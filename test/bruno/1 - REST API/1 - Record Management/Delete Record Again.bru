meta {
  name: Delete Record Again
  type: http
  seq: 25
}

delete {
  url: {{host}}/default/rdmp/api/records/metadata/{{strictLifecycleOid}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  If-Match: {{strictLifecycleRestoredEtag}}
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
      const etag = res.getHeader("etag");
      expect(etag).to.match(/^".+"$/);
      bru.setEnvVar("strictLifecycleFinalTombstoneEtag", etag);
  });
  
  test("Success is set and is true", function () {
      var jsonData = res.getBody();
      expect(jsonData).to.have.property('success');
      expect(jsonData.success).to.eql(true);
  });
}
