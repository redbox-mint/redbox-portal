meta {
  name: Validate Workflow Stage Settings
  type: http
  seq: 3
}

post {
  url: {{host}}/default/rdmp/api/dashboard-config/validate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
}

body:json {
  {
    "target": { "kind": "workflow", "recordType": "rdmp", "stage": "draft" },
    "expectedRevision": {{dashboardConfigRevision}},
    "settings": {{dashboardConfigDraftSettings}}
  }
}

script:post-response {
  var data = res.getBody().data;
  bru.setVar("dashboardConfigValidationFingerprint", data.validationFingerprint);
  bru.setVar("dashboardConfigAcknowledgedWarningIds", JSON.stringify(data.warnings.map(function (warning) { return warning.id; })));
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Settings are valid and warnings can be reviewed before save", function () {
    var data = res.getBody().data;
    expect(data.errors).to.deep.equal([]);
    expect(data.validationFingerprint).to.be.a("string");
    expect(data.warnings).to.be.an("array");
  });
}
