meta {
  name: Reject Invalid GraphQL Definition
  type: http
  seq: 20
}

post {
  url: {{host}}/default/rdmp/api/named-query
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
}

body:json {
  {
    "name": "bruno-invalid-graphql-query",
    "source": "graphql",
    "graphql": {
      "document": "mutation { forbiddenMutation }",
      "variables": {},
      "resultPath": ["forbiddenMutation"]
    }
  }
}

tests {
  test("Server rejects GraphQL that cannot pass current-schema validation", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.have.property("errors");
  });
}
