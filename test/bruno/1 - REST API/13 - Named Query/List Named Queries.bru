meta {
  name: List Named Queries
  type: http
  seq: 1
}

get {
  url: {{host}}/default/rdmp/api/named-query
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Has data property", function () {
    var jsonData = res.getBody();
    expect(jsonData).to.have.property("data");
    expect(jsonData.data).to.be.an("array");
  });
  test("Each query exposes safe, brand-relative usage metadata", function () {
    res.getBody().data.forEach(function (query) {
      expect(query.usedBy).to.be.an("array");
      query.usedBy.forEach(function (consumer) {
        expect(consumer).to.have.all.keys("type", "name", "path");
        expect(consumer.path).to.match(/^\/(admin|dashboard|dashboard-view|query|record)\//);
      });
    });
  });
}
