meta {
  name: Review Named Query Update
  type: http
  seq: 4.4
}

post {
  url: {{host}}/default/rdmp/api/named-query/bruno-test-query/review-update
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
  X-CSRF-Token: {{queryEditorCsrf}}
}

body:json {
  {
    "definition": {
    "name": "bruno-test-query",
    "collectionName": "user",
    "mongoQuery": {
      "type": "researcher"
    },
    "queryParams": {},
    "resultObjectMapping": {
      "name": "{{record.name}}"
    },
    "brandIdFieldPath": "branding",
    "sort": [],
    "expandRelations": false,
    "relatedRecordFilters": []
  }
  }
}

script:pre-request {
  require("./bruno-helpers.js").setCookies({ bru, req, bruCookieVar: "queryEditorCookie" });
}

tests {
  test("Review identifies immediate parameter and mapping changes", () => {
    expect(res.getStatus()).to.equal(200);
    const review = res.getBody().data;
    expect(review.required).to.equal(true);
    expect(review.changes).to.include("parameters");
    expect(review.changes).to.include("mappings");
    expect(review.usageComplete).to.equal(false);
    expect(review.confirmation).to.be.a("string");
    bru.setVar("queryUpdateConfirmation", review.confirmation);
  });
}
