meta {
  name: Editor Describe
  type: http
  seq: 11
}

post {
  url: {{host}}/default/rdmp/api/named-query/editor/describe
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
  Accept: application/json
  X-CSRF-Token: {{queryEditorCsrf}}
}

body:json {
  {
    "definition": {
      "collectionName": "record",
      "mongoQuery": {
        "metaMetadata.type": "rdmp"
      },
      "queryParams": {},
      "resultObjectMapping": {
        "projectTitle": "record.metadata.title"
      }
    }
  }
}

script:pre-request {
  require("./bruno-helpers.js").setCookies({ bru, req, bruCookieVar: "queryEditorCookie" });
}

tests {
  test("Request succeeds", () => expect(res.getStatus()).to.equal(200));
  test("Mapped alias uses result metadata wrapper", () => expect(JSON.stringify(res.getBody().data.result)).to.include("metadata.projectTitle"));
}
