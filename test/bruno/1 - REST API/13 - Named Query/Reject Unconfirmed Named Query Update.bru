meta {
  name: Reject Unconfirmed Named Query Update
  type: http
  seq: 4.1
}

put {
  url: {{host}}/default/rdmp/api/named-query/bruno-test-query
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
}

body:json {
  {
    "name": "bruno-test-query",
    "collectionName": "user",
    "mongoQuery": {
      "type": "researcher"
    },
    "queryParams": {},
    "resultObjectMapping": {
      "name": "{{record.name}}"
    },
    "brandIdFieldPath": "branding",
    "sort": [],
    "expandRelations": false,
    "relatedRecordFilters": []
  }
}

tests {
  test("Breaking changes cannot bypass explicit server review", () => {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().errors[0].code).to.equal("NAMED_QUERY_CONFIRMATION_REQUIRED");
  });
}
