meta {
  name: Editor Preview
  type: http
  seq: 12
}

post {
  url: {{host}}/default/rdmp/api/named-query/editor/preview
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
  Accept: application/json
  X-CSRF-Token: {{queryEditorCsrf}}
}

body:json {
  {
    "definition": {
      "collectionName": "record",
      "mongoQuery": {
        "metaMetadata.type": "rdmp"
      },
      "queryParams": {},
      "resultObjectMapping": {
        "projectTitle": "record.metadata.title"
      }
    },
    "limits": {
      "rows": 10000
    }
  }
}

script:pre-request {
  require("./bruno-helpers.js").setCookies({ bru, req, bruCookieVar: "queryEditorCookie" });
}

tests {
  test("Request succeeds", () => expect(res.getStatus()).to.equal(200));
  test("Server limits bound explicit real-data preview", () => {
    const data = res.getBody().data;
    expect(data.valid).to.equal(true);
    expect(data.records.length).to.be.at.most(100);
    expect(data.limits.rows).to.equal(100);
    expect(data.truncated).to.be.a("boolean");
  });
}
