meta {
  name: Logo upload success
  type: http
  seq: 12
}

post {
  url: {{host}}/default/rdmp/api/branding/logo
  body: multipartForm
  auth: none
}

headers {
     Authorization: Bearer {{token}}
}

body:multipart-form {
  expectedDraftRevision: {{image_revision}}
  logo: @file(attachment.png)
}

script:pre-request {
  const axios = require('axios');
  const state = await axios.get(bru.interpolate('{{host}}/default/rdmp/api/branding/config'), {
    headers: { Authorization: bru.interpolate('Bearer {{token}}') }
  });
  bru.setVar('image_revision', state.data.draft.revision);
}

tests {
  test("Status 200", function(){
    expect(res.getStatus()).to.equal(200);
  });
  test("Hash returned", function(){
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body).to.have.property('hash');
  });
}
