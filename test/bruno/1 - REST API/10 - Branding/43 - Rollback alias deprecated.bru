meta {
  name: Rollback alias deprecated
  type: http
  seq: 43
}

post {
  url: {{host}}/default/rdmp/api/branding/rollback/{{rb_version_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "expectedVersion": {{rb_version}},
    "expectedDraftRevision": {{rb_revision}}
  }
}

tests {
  test("Status code is 200 with restore semantics", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.active.version).to.be.above(parseInt(bru.getVar('rb_version'), 10));
    bru.setVar('rb_version', body.active.version);
    bru.setVar('rb_revision', body.draft.revision);
  });
  test("Deprecation header present", function(){
    var headers = res.getHeaders();
    expect(headers['deprecation']).to.equal('true');
  });
}
