meta {
  name: Public font HEAD
  type: http
  seq: 39
}

head {
  url: {{host}}/fonts/branding/default/{{rb_face_sha}}.woff2
  auth: none
}

tests {
  test("Status code is 200 with ETag and no font substitution", function(){
    expect(res.getStatus()).to.equal(200);
    var headers = res.getHeaders();
    expect(headers['content-type']).to.contain('font/woff2');
    expect(headers['etag']).to.equal('"' + bru.getVar('rb_face_sha') + '"');
  });
}
