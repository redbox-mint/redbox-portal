meta {
  name: Preview create single use
  type: http
  seq: 46
}

post {
  url: {{host}}/default/rdmp/api/branding/preview
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "expectedDraftRevision": {{rb_revision}}
  }
}

tests {
  test("Store preview url", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = (typeof raw === 'string') ? JSON.parse(raw) : raw;
    bru.setVar('preview_single_url', body.url);
  });
}
