meta {
  name: Face upload regular
  type: http
  seq: 33
}

put {
  url: {{host}}/default/rdmp/api/branding/draft/typeface/faces/regular
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:multipart-form {
  face: @file(test-font-regular.woff2)
  expectedDraftRevision: {{rb_revision}}
}

tests {
  test("Upload succeeds with face hash", function(){
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(res.getStatus(), 'upload response: ' + JSON.stringify(body).slice(0, 400)).to.equal(200);
    var sha = body.draft.typeface.faces.regular.sha256;
    expect(sha).to.match(/^[0-9a-f]{64}$/);
    bru.setVar('rb_face_sha', sha);
    bru.setVar('rb_revision', body.draft.revision);
  });
}
