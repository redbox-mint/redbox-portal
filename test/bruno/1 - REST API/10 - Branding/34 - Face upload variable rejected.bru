meta {
  name: Face upload variable rejected
  type: http
  seq: 34
}

put {
  url: {{host}}/default/rdmp/api/branding/draft/typeface/faces/bold
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:multipart-form {
  face: @file(test-font-variable.woff2)
  expectedDraftRevision: {{rb_revision}}
}

tests {
  test("Status code is 400", function(){
    expect(res.getStatus()).to.equal(400);
  });
  test("Variable font rejected", function(){
    var raw = res.getBody();
    expect(JSON.stringify(typeof raw === 'string' ? JSON.parse(raw) : raw)).to.contain('typeface-variable-font');
  });
}
