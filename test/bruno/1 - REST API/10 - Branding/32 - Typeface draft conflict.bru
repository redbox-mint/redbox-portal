meta {
  name: Typeface draft conflict
  type: http
  seq: 32
}

post {
  url: {{host}}/default/rdmp/api/branding/draft
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "variables": {
      "site-branding-area-background-color": "#000000"
    },
    "expectedDraftRevision": 999999
  }
}

tests {
  test("Status code is 409", function(){
    expect(res.getStatus()).to.equal(409);
  });
  test("Conflict mentions stale draft", function(){
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(JSON.stringify(body)).to.contain('branding-conflict');
  });
}
