meta {
  name: Typeface version preview
  type: http
  seq: 41
}

post {
  url: {{host}}/default/rdmp/api/branding/versions/{{rb_version_id}}/preview
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test("Status code is 200 with preview token", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.token).to.exist;
  });
}
