meta {
  name: Publish default typography
  type: http
  seq: 45
}

post {
  url: {{host}}/default/rdmp/api/branding/publish
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "expectedVersion": {{rb_version}},
    "expectedDraftRevision": {{rb_revision}}
  }
}

tests {
  test("Default Typography publishes without faces", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.active.typeface.mode).to.equal('default');
    bru.setVar('rb_version', body.active.version);
    bru.setVar('rb_revision', body.draft.revision);
  });
}
