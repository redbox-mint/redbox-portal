meta {
  name: Typeface publish idempotent
  type: http
  seq: 37
}

post {
  url: {{host}}/default/rdmp/api/branding/publish
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "expectedVersion": {{rb_version}},
    "expectedDraftRevision": {{rb_revision}}
  }
}

tests {
  test("Status code is 200 with idempotent flag", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body).to.have.property('idempotent', true);
    expect(body.active.version).to.equal(parseInt(bru.getVar('rb_version'), 10));
  });
}
