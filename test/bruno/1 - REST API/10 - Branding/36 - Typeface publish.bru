meta {
  name: Typeface publish
  type: http
  seq: 36
}

post {
  url: {{host}}/default/rdmp/api/branding/publish
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "expectedVersion": {{rb_version}},
    "expectedDraftRevision": {{rb_revision}}
  }
}

tests {
  test("Status code is 200", function(){
    expect(res.getStatus()).to.equal(200);
  });
  test("Published with new version and aligned draft", function(){
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.active.version).to.be.a('number');
    expect(body.active.typeface.mode).to.equal('custom');
    expect(body.draft.dirty.colours).to.equal(false);
    expect(body.draft.dirty.typeface).to.equal(false);
    bru.setVar('rb_version', body.active.version);
    bru.setVar('rb_revision', body.draft.revision);
  });
}
