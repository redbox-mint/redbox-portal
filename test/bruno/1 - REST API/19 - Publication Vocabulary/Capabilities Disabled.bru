meta {
  name: Publication Vocabulary Capabilities Disabled
  type: http
  seq: 5
}

get {
  url: {{host}}/default/rdmp/api/publication-vocabularies/capabilities
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-ReDBox-Api-Version: 2.0
}

tests {
  test("Shared vocabulary administration stays disabled", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
