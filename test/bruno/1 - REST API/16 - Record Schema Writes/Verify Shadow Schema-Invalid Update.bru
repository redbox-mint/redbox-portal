meta {
  name: Verify Shadow Schema-Invalid Update
  type: http
  seq: 4
}

get {
  url: {{host}}/default/rdmp/api/records/metadata/{{recordSchemaShadowOid}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("Reads back the schema-invalid update accepted in shadow mode", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().text_1_event).to.deep.equal({ invalid: true });
  });
}
