meta {
  name: Shadow Schema-Invalid Update
  type: http
  seq: 3
}

put {
  url: {{host}}/default/rdmp/api/records/metadata/{{recordSchemaShadowOid}}?merge=true
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  X-ReDBox-Api-Version: 2.0
}

body:json {
  {
    "text_1_event": {
      "invalid": true
    }
  }
}

tests {
  test("Persists schema-invalid update input with an advisory in shadow mode", function () {
    expect(res.getStatus()).to.equal(200);

    const body = res.getBody();
    expect(body.data.outcome).to.equal("saved-with-warnings");
    expect(body.data.oid).to.equal(bru.getEnvVar("recordSchemaShadowOid"));

    const schemaProblem = body.meta.problems.find(
      problem => problem.source === "schema" && problem.phase === "schema"
    );
    expect(schemaProblem, "schema advisory problem").to.be.an("object");
    expect(schemaProblem.issues).to.deep.include({
      code: "record-schema.type",
      message: "@record-schema.type",
      pointer: "/text_1_event",
      expected: { type: "string" }
    });
  });

  test("Returns schema discovery for the successful shadow update", function () {
    const link = res.getHeader("link");
    const match = /^<\/default\/rdmp\/api\/records\/schemas\/([0-9a-f]{64})>; rel="describedby"; type="application\/schema\+json"$/.exec(
      link || ""
    );
    expect(match, "describedby Link header").not.to.equal(null);
    bru.setEnvVar("recordSchemaShadowUpdateDigest", match[1]);
  });
}
