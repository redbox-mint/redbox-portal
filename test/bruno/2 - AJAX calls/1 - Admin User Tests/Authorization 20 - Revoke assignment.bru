meta {
  name: Authorization - Revoke assignment
  type: http
  seq: 53
}

delete {
  url: {{host}}/default/rdmp/api/authorization/assignments/Librarians/users/{{researcherUserId}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
  X-Source: jsclient
}

body:json {
  {
    "expectedVersion": {{authorizationAssignmentVersion}},
    "reason": "Reviewed Bruno assignment revoke"
  }
}

tests {
  test("Revokes only the exact manual tuple", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.changed).to.equal(true);
    expect(body.data).to.include({ source: "manual", sourceKey: "manual", status: "revoked" });
  });
}
