meta {
  name: Progress 3 - Finish
  type: http
  seq: 57.3
}

delete {
  url: {{host}}/default/rdmp/asynch
  body: json
  auth: none
}

body:json {
  {"id":"{{j1ProgressId}}"}
}

headers {
  Content-Type: application/json
  X-Source: jsclient
  Accept: application/json
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Finishes the owner's progress and retains completion time", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal('finished');
    expect(res.getBody().date_completed).to.be.a('string').and.not.equal('');
  });
}
