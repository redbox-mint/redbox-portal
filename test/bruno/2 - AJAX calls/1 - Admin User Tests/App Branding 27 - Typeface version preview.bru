meta {
  name: App Typeface version preview
  type: http
  seq: 59
}

post {
  url: {{host}}/default/rdmp/app/branding/versions/{{app_version_id}}/preview
  body: json
  auth: none
}

headers {
  X-Source: jsclient
  Content-Type: application/json
  Accept: application/json, text/plain, */*
}

body:json {
  {}
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Status code is 200 with preview token", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.previewToken).to.exist;
  });
}
