meta {
  name: AI Generation 6 - Read result
  type: http
  seq: 65
}

get {
  url: {{host}}/default/rdmp/generation/runs/{{generationRunId}}
  body: none
  auth: none
}

headers {
  Origin: {{host}}
  X-Source: jsclient
  X-ReDBox-Api-Version: 2.0
}

script:pre-request {
  await new Promise((resolve) => setTimeout(resolve, 8000));
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Returns a validated candidate", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.status).to.equal("completed");
    expect(data.result.items).to.have.length(9);
    expect(data.result.items.filter((item) => item.reviewRequired)).to.have.length(1);
    bru.setEnvVar("generationCandidateDigest", data.result.candidateDigest);
  });
}
