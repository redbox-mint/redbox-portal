meta {
  name: Authorization - Reject partial bulk apply
  type: http
  seq: 92
}

post {
  url: {{host}}/default/rdmp/api/authorization/assignments/bulk-apply
  body: json
  auth: none
}

headers {
  Accept: application/problem+json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "rows": [
      {
        "action": "grant",
        "principalId": "{{researcherUserId}}",
        "roleKey": "bruno-phase86-bulk-role"
      },
      {
        "action": "grant",
        "principalId": "missing-phase86-principal",
        "roleKey": "bruno-phase86-bulk-role"
      }
    ],
    "reason": "No valid row may be written from an invalid batch",
    "confirmationToken": "invalid-token"
  }
}

tests {
  test("Rejects the entire semantically invalid batch", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody()).to.include({ status: 422, code: "authorization.bulk-invalid" });
  });
}
