meta {
  name: App Typeface draft invalid variables
  type: http
  seq: 54
}

post {
  url: {{host}}/default/rdmp/app/branding/draft
  body: json
  auth: none
}

headers {
  X-Source: jsclient
  Content-Type: application/json
  Accept: application/json, text/plain, */*
}

body:json {
  {
    "variables": {
      "not-allowed-var": "#abcdef"
    },
    "expectedDraftRevision": {{app_revision}}
  }
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Status code is 400 for invalid variables", function(){
    expect(res.getStatus()).to.equal(400);
  });
}
