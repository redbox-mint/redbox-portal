meta {
  name: App Typeface config
  type: http
  seq: 52
}

get {
  url: {{host}}/default/rdmp/app/branding/config
  auth: none
}

headers {
  X-Source: jsclient
  Accept: application/json, text/plain, */*
  Content-Type: application/json
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Status code is 200", function(){
    expect(res.getStatus()).to.equal(200);
  });
  test("Canonical Admin state with counters", function(){
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.draft.revision).to.be.a('number');
    expect(body.versions).to.be.an('array');
    bru.setVar('app_revision', body.draft.revision);
    bru.setVar('app_version', body.active.version);
  });
}
