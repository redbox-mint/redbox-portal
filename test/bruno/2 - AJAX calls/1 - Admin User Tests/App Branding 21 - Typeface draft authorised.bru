meta {
  name: App Typeface draft authorised
  type: http
  seq: 53
}

post {
  url: {{host}}/default/rdmp/app/branding/draft
  body: json
  auth: none
}

headers {
  X-Source: jsclient
  Content-Type: application/json
  Accept: application/json, text/plain, */*
}

body:json {
  {
    "variables": {
      "primary": "#112233"
    },
    "expectedDraftRevision": {{app_revision}}
  }
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Status code is 200", function(){
    expect(res.getStatus()).to.equal(200);
  });
  test("Draft saved with new revision", function(){
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.draft.variables['primary']).to.equal('#112233');
    bru.setVar('app_revision', body.draft.revision);
  });
}
