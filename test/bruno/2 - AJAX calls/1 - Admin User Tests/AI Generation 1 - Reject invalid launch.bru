meta {
  name: AI Generation 1 - Reject invalid launch
  type: http
  seq: 60
}

post {
  url: {{host}}/default/rdmp/generation/launch
  body: json
  auth: none
}

headers {
  Origin: {{host}}
  X-Source: jsclient
  X-ReDBox-Api-Version: 2.0
  Content-Type: application/json
}

body:json {
  {
    "bindingKey": "create-demo-rdmp-from-activity"
  }
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Rejects a launch without a source record", function () {
    expect(res.getStatus()).to.equal(400);
    const body = res.getBody();
    expect(body.errors[0].code).to.equal("GENERATION_REQUEST_INVALID");
  });
}
