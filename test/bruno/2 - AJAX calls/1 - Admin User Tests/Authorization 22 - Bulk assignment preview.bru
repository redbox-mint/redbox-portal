meta {
  name: Authorization - Bulk assignment preview
  type: http
  seq: 53
}

post {
  url: {{host}}/default/rdmp/api/authorization/assignments/bulk-preview
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
  X-Source: jsclient
}

body:json {
  {
    "rows": [
      {
        "action": "grant",
        "principalId": "{{researcherUserId}}",
        "roleKey": "Librarians"
      }
    ],
    "reason": "Reviewed Bruno assignment batch"
  }
}

tests {
  test("Returns a bounded server-authoritative batch preview", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.include({ grantCount: 1, revokeCount: 0, noOpCount: 0, invalidCount: 0 });
    expect(body.confirmationToken).to.be.a("string").and.not.empty;
    bru.setVar("authorizationBulkToken", body.confirmationToken);
  });
}
