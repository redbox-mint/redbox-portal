meta {
  name: Authorization - Role detail
  type: http
  seq: 52
}

get {
  url: {{host}}/default/rdmp/api/authorization/roles/Researcher
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Source: jsclient
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Preserves the grandfathered role key and returns revision state", function () {
    const body = res.getBody();
    expect(body.key).to.equal("Researcher");
    expect(body.contextType).to.equal("brand");
    expect(body.baseScopeKeys).to.be.an("array");
    expect(body.effectiveScopeKeys).to.be.an("array");
    expect(body.overrides).to.be.an("array");
    expect(body.version).to.be.a("number").and.greaterThan(0);
  });
}
