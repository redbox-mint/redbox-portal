meta {
  name: Authorization - Restricted bearer denied
  type: http
  seq: 64
}

post {
  url: {{host}}/default/rdmp/api/authorization/roles
  body: json
  auth: none
}

headers {
  Accept: application/problem+json
  Content-Type: application/json
  Authorization: Bearer {{authorizationRestrictedToken}}
}

body:json {
  {
    "key": "restricted-bearer-must-not-create",
    "displayName": "Restricted bearer must not create"
  }
}

tests {
  test("A valid bearer cannot exceed its effective user scopes", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.headers["content-type"]).to.include("application/problem+json");
    const body = res.getBody();
    expect(body).to.include({ status: 403, code: "access-denied" });
    expect(body.requestId).to.be.a("string").and.not.empty;
  });
}
