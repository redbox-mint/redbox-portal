meta {
  name: Authorization - Oversized UTF-8 payload
  type: http
  seq: 89
}

post {
  url: {{host}}/default/rdmp/api/authorization/assignments/bulk-preview
  body: json
  auth: none
}

headers {
  Accept: application/problem+json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "rows": {{authorizationOversizedUtf8Payload}}
  }
}

script:pre-request {
  bru.setVar("authorizationOversizedUtf8Payload", JSON.stringify("😀".repeat(65537)));
}

tests {
  test("Enforces the 256 KiB bound in UTF-8 bytes", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.include({ status: 400, code: "authorization.invalid-request" });
  });
}
