meta {
  name: App Rollback alias deprecated
  type: http
  seq: 61
}

post {
  url: {{host}}/default/rdmp/app/branding/rollback/{{app_version_id}}
  body: json
  auth: none
}

headers {
  X-Source: jsclient
  Content-Type: application/json
  Accept: application/json, text/plain, */*
}

body:json {
  {
    "expectedVersion": {{app_version}},
    "expectedDraftRevision": {{app_revision}}
  }
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Status code is 200 with restore semantics", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body.active.version).to.be.above(parseInt(bru.getVar('app_version'), 10));
  });
  test("Deprecation header present", function(){
    expect(res.getHeader('deprecation')).to.equal('true');
  });
}
