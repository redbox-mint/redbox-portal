meta {
  name: Authorization - Filter assignment list
  type: http
  seq: 53
}

get {
  url: {{host}}/default/rdmp/api/authorization/assignments?userId={{researcherUserId}}&roleKey=Librarians&source=manual&status=active&sourcePresent=true&expiry=unexpired&limit=1
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Source: jsclient
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Applies every assignment filter server-side", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.items).to.have.length(1);
    expect(body.items[0].id).to.equal(bru.getVar("authorizationAssignmentId"));
  });
}
