meta {
  name: Missing CSRF clearSecret
  type: http
  seq: 26
}

delete {
  url: {{host}}/default/rdmp/admin/record-definitions/B09MissingDefinition/draft/actions/actb_00000000000000000000000000000000/secrets/credential
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Source: jsclient
}

script:pre-request {
  const cookie = bru.getVar("cookie") || bru.getEnvVar("adminCookie");
  if (cookie) req.setHeader("Cookie", cookie);
}

body:json {
  {}
}

tests {
  test("Expected status 403", () => expect(res.getStatus()).to.equal(403));
  test("No sensitive response data", () => {
    const text = JSON.stringify(res.getBody());
    expect(text).not.to.include("B09-bruno-secret-sentinel");
    expect(text).not.to.include("protectedValue");
    expect(text).not.to.include('"handler"');
  });

}
