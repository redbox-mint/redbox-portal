meta {
  name: Authorization - Role inactivation preview
  type: http
  seq: 80
}

post {
  url: {{host}}/default/rdmp/api/authorization/roles/bruno-phase86-role/inactivation-preview
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "expectedVersion": {{authorizationRoleVersion}},
    "reason": "Review the role retirement impact"
  }
}

tests {
  test("Returns a dependency-bounded inactivation preview", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.fatalErrors).to.deep.equal([]);
    expect(body.confirmationToken).to.be.a("string").and.not.empty;
    bru.setVar("authorizationRoleInactivationToken", body.confirmationToken);
  });
}
