meta {
  name: App Branding - Logo upload success
  type: http
  seq: 51
}

post {
  url: {{host}}/default/rdmp/app/branding/logo
  body: multipartForm
  auth: none
}

headers {
  X-Source: jsclient
  Accept: application/json, text/plain, */*
}

body:multipart-form {
  expectedDraftRevision: {{image_revision}}
  logo: @file(attachment.png)
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
  const axios = require('axios');
  const state = await axios.get(bru.interpolate('{{host}}/default/rdmp/app/branding/config'), { headers: req.headers });
  bru.setVar('image_revision', state.data.draft.revision);
}

tests {
  test("Status code is 200", function(){
    expect(res.getStatus()).to.equal(200);
  });

  test("JSON content type", function(){
    expect(res.getHeader('content-type')).to.contain('application/json');
  });

  test("Logo hash returned", function(){
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body && /^[a-f0-9]{64}$/.test(body.draft.images.logo.sha256)).to.equal(true);
  });
}
