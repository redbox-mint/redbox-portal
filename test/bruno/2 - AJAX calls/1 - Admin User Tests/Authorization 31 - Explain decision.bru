meta {
  name: Authorization - Explain decision
  type: http
  seq: 54
}

post {
  url: {{host}}/default/rdmp/api/authorization/explain
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
  X-Source: jsclient
}

body:json {
  {
    "subjectId": "{{authorizationActorUserId}}",
    "brandId": "default",
    "scopeKey": "system.authorization.manage"
  }
}

tests {
  test("Explains a hypothetical decision without exposing credentials", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.explained).to.equal(true);
    expect(body.decision.allowed).to.equal(true);
    expect(body.projection.effectiveScopeKeys).to.include("system.authorization.manage");
    expect(JSON.stringify(body)).not.to.include("rbadmin");
    expect(JSON.stringify(body)).not.to.include("Bearer ");
  });
}
