meta {
  name: Background Exports - Deleted export list
  type: http
  seq: 12
}

get {
  url: {{host}}/default/rdmp/export/jobs
  body: none
  auth: none
}

headers {
  X-Source: jsclient
  X-ReDBox-Api-Version: 2.0
}

script:pre-request {
  require("./bruno-helpers.js").setCookies({ bru, req, bruCookieVar: "backgroundExportCookie" });
}

tests {
  test("Deleted exports disappear from the recent list", function () {
    expect(res.getStatus()).to.equal(200);
    const jobs = res.getBody().data;
    expect(jobs).to.be.an("array");
    expect(jobs.some(job => job.id === bru.getVar("backgroundExportId"))).to.equal(false);
  });
}
