meta {
  name: Authorization - Reject protected inactivation
  type: http
  seq: 79
}

post {
  url: {{host}}/default/rdmp/api/authorization/roles/Guest/inactivation-preview
  body: json
  auth: none
}

headers {
  Accept: application/problem+json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "expectedVersion": {{authorizationGuestVersion}},
    "reason": "Protected Guest must remain active"
  }
}

tests {
  test("Rejects a protected-role lifecycle attack", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.headers["content-type"]).to.include("application/problem+json");
    const body = res.getBody();
    expect(body).to.include({ status: 409, code: "authorization.protected-role" });
    expect(body.requestId).to.be.a("string").and.not.empty;
  });
}
