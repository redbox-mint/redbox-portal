meta {
  name: App Typeface versions list
  type: http
  seq: 58
}

get {
  url: {{host}}/default/rdmp/app/branding/versions
  auth: none
}

headers {
  X-Source: jsclient
  Accept: application/json, text/plain, */*
  Content-Type: application/json
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Status code is 200 with versions", function(){
    expect(res.getStatus()).to.equal(200);
    var raw = res.getBody();
    var body = typeof raw === 'string' ? JSON.parse(raw) : raw;
    expect(body).to.be.an('array');
    expect(body.length).to.be.above(0);
    bru.setVar('app_version_id', body[0].id);
  });
}
