meta {
  name: Authorization - Oversized import payload
  type: http
  seq: 94
}

post {
  url: {{host}}/default/rdmp/api/authorization/import-preview
  body: json
  auth: none
}

headers {
  Accept: application/problem+json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "document": {{authorizationOversizedImportPayload}}
  }
}

script:pre-request {
  bru.setVar("authorizationOversizedImportPayload", JSON.stringify("😀".repeat(65537)));
}

tests {
  test("Rejects an import beyond 256 KiB in UTF-8 bytes", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.include({ status: 400, code: "authorization.invalid-request" });
  });
}
