meta {
  name: AI Generation 4 - Read draft
  type: http
  seq: 63
}

get {
  url: {{host}}/default/rdmp/generation/runs/{{generationRunId}}
  body: none
  auth: none
}

headers {
  Origin: {{host}}
  X-Source: jsclient
  X-ReDBox-Api-Version: 2.0
}

script:pre-request {
  const bruHelper = require("./bruno-helpers.js");
  bruHelper.setCookies({bru, req});
}

tests {
  test("Returns the draft questions without a candidate", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.status).to.equal("draft");
    expect(data.questions).to.have.length(5);
    expect(data.result).to.equal(null);
  });
}
