meta {
  name: Email templates - Discard restored draft
  type: http
  seq: 16
}

delete {
  url: {{host}}/default/rdmp/app/email-templates/templates/test/draft
  body: json
  auth: none
}

headers {
  X-Source: jsclient
  Content-Type: application/json
  Accept: application/json
  X-CSRF-Token: {{emailAdminCsrf}}
}

body:json {
  { "expectedDraftRevision": {{emailAdminDraftRevision}} }
}

script:pre-request {
  require("./bruno-helpers.js").setCookies({ bru, req, bruCookieVar: "emailAdminCookie" });

}

tests {
  test("Discards using the expected revision", () => { expect(res.getStatus()).to.equal(200); expect(res.getBody().discarded).to.equal(true); });
}
