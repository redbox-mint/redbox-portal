meta {
  name: Get view form config for RDMP - Unauthorised
  type: http
  seq: 1
}

get {
  url: {{host}}/default/rdmp/record/form/auto/{{dmpOid}}?edit=false
  body: none
  auth: none
}

query {
  edit: false
}

headers {
  Content-Type: application/json
  X-Source: jsclient
  Accept: application/json, text/plain, */*
}

tests {
  test("Status code is 401 for unauthenticated request", function () {
      expect(res.getStatus()).to.equal(401);
  });
  
  test("Problem identifies authentication as required", function () {
      var jsonData = res.getBody();
      
      expect(jsonData.code).to.eql("authentication-required");
  });
}
