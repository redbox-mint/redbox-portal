<h1>{{record.metadata.title}}</h1>
{{#if record.metadata.notes}}<p>Local notes: {{record.metadata.notes}}</p>{{/if}}
{{#each record.relatedMetadata}}
<p>{{@key}} status: {{status}}</p>
{{#each records}}
<p>{{metadata.title}}{{#if metadata.startDate}}: {{metadata.startDate}}{{/if}}{{#if metadata.endDate}} – {{metadata.endDate}}{{/if}}</p>
{{/each}}
{{/each}}
