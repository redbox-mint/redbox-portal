<% /* Brand Typeface: keep Google fonts for Default Typography only. */ %>
<% if (!page.typeface) { %>
<link href='https://fonts.googleapis.com/css?family=Open+Sans:400italic,600' rel='stylesheet' type='text/css'>
<% } %>
<% let appName='dashboard' ; %>
<% if (typeof showAdminSideBar !== 'undefined' && showAdminSideBar) { %>
<div class="row admin-layout">
  <div class="col-md-3 col-lg-2">
    <%- include('../default/admin/layout/sidebar.ejs') %>
  </div>
  <div class="col-md-9 col-lg-10 admin-main-content">
    <div class="default-page">
      <div class="header">
        <h1 id="main-title" class="container">
          <%= titleLabel %>
        </h1>
      </div>
      <div class="main container clearfix">
        <dashboard recordType="<%= typeof recordType == 'undefined'? data.recordType : recordType %>"
          dashboardType="<%= typeof dashboardType == 'undefined' ? 'standard' : dashboardType %>" dashboardView="<%= typeof dashboardView == 'undefined' ? '' : dashboardView %>" packageType="<%= typeof packageType == 'undefined' ? data.recordType : packageType %>" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
          <div class="col-xs-1">
          </div>
          <div class="col-xs-10">
            <img class="center-block" src="<%= page.root %>/images/loading.svg"
              alt="<%= page.t('loading-alt-text') %>">
          </div>
          <div class="col-xs-1">
          </div>
        </dashboard>
      </div>
    </div>
  </div>
</div>
<% } else { %>
  <div class="default-page">
    <div class="header">
      <h1 id="main-title" class="container">
        <%= titleLabel %>
      </h1>
    </div>
    <div class="main container clearfix">
      <dashboard recordType="<%= typeof recordType == 'undefined'? data.recordType : recordType %>"
        dashboardType="<%= typeof dashboardType == 'undefined' ? 'standard' : dashboardType %>" dashboardView="<%= typeof dashboardView == 'undefined' ? '' : dashboardView %>" packageType="<%= typeof packageType == 'undefined' ? data.recordType : packageType %>" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
        <div class="col-xs-1">
        </div>
        <div class="col-xs-10">
          <img class="center-block" src="<%= page.root %>/images/loading.svg"
            alt="<%= page.t('loading-alt-text') %>">
        </div>
        <div class="col-xs-1">
        </div>
      </dashboard>
    </div>
</div>
<% } %>
<script src="<%= page.root %>/angular/<%= appName %>/browser/main<%= page.bundleHash(appName, 'main', '-') %>.js"
    type="module"></script>
<link rel="stylesheet"
  href="<%= page.root %>/angular/<%= appName %>/browser/styles<%= page.bundleHash(appName, 'styles', '-') %>.css">
