<% /* Public dashboard legacy font; admin Parties uses the shared shell typography. */ %>
<% if (!(typeof adminParties !== 'undefined' && adminParties) && !BrandingService.hasActiveCustomTypeface(BrandingService.getBrandNameFromReq(req))) { %>
<link href='https://fonts.googleapis.com/css?family=Open+Sans:400italic,600' rel='stylesheet' type='text/css'>
<% } %>
<% let appName='dashboard' ; %>
<% if (typeof adminParties !== 'undefined' && adminParties) { %>
<%- include('../default/admin/layout/start.ejs') %>
<%- include('../default/admin/layout/page-header.ejs', {
  breadcrumbs: [{ labelKey: 'menu-admin', href: BrandingService.getBrandAndPortalPath(req) + '/admin' }, { labelKey: 'admin-nav-lookups' }, { labelKey: 'admin-nav-party' }],
  titleKey: req.query.import === 'csv' ? 'admin-parties-import-title' : 'admin-nav-party', descriptionKey: 'admin-parties-description',
  actions: req.query.import === 'csv' ? [{ labelKey: 'admin-parties-back', href: BrandingService.getBrandAndPortalPath(req) + '/admin/parties' }] : [
    { labelKey: 'admin-parties-import-title', href: BrandingService.getBrandAndPortalPath(req) + '/admin/parties?import=csv' },
    { labelKey: 'admin-parties-add', href: BrandingService.getBrandAndPortalPath(req) + '/record/party/edit?returnTo=parties', primary: true, icon: 'plus' }
  ]
}) %>
<dashboard recordType="party" packageType="party" dashboardType="standard" adminParties="true" adminPartyImport="<%= req.query.import === 'csv' %>" <% if (typeof contentSecurityPolicyNonce !== 'undefined' && contentSecurityPolicyNonce) { %>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
  <img class="center-block" src="<%= BrandingService.getRootContext() %>/images/loading.svg" alt="<%= TranslationService.t('loading-alt-text') %>">
</dashboard>
<%- include('../default/admin/layout/end.ejs') %>
<% } else if (typeof showAdminSideBar !== 'undefined' && showAdminSideBar) { %>
<%- include('../default/admin/layout/start.ejs') %>
    <div class="default-page">
      <div class="header">
        <h1 id="main-title" class="container">
          <%= titleLabel %>
        </h1>
      </div>
      <div class="main container clearfix">
        <dashboard recordType="<%= typeof recordType == 'undefined'? data.recordType : recordType %>"
          dashboardType="<%= typeof dashboardType == 'undefined' ? 'standard' : dashboardType %>" dashboardView="<%= typeof dashboardView == 'undefined' ? '' : dashboardView %>" packageType="<%= typeof packageType == 'undefined' ? data.recordType : packageType %>" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
          <div class="col-xs-1">
          </div>
          <div class="col-xs-10">
            <img class="center-block" src="<%= BrandingService.getRootContext() %>/images/loading.svg"
              alt="<%= TranslationService.t('loading-alt-text') %>">
          </div>
          <div class="col-xs-1">
          </div>
        </dashboard>
      </div>
    </div>
<%- include('../default/admin/layout/end.ejs') %>
<% } else { %>
  <div class="default-page">
    <div class="header">
      <h1 id="main-title" class="container">
        <%= titleLabel %>
      </h1>
    </div>
    <div class="main container clearfix">
      <dashboard recordType="<%= typeof recordType == 'undefined'? data.recordType : recordType %>"
        dashboardType="<%= typeof dashboardType == 'undefined' ? 'standard' : dashboardType %>" dashboardView="<%= typeof dashboardView == 'undefined' ? '' : dashboardView %>" packageType="<%= typeof packageType == 'undefined' ? data.recordType : packageType %>" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
        <div class="col-xs-1">
        </div>
        <div class="col-xs-10">
          <img class="center-block" src="<%= BrandingService.getRootContext() %>/images/loading.svg"
            alt="<%= TranslationService.t('loading-alt-text') %>">
        </div>
        <div class="col-xs-1">
        </div>
      </dashboard>
    </div>
</div>
<% } %>
<script src="<%= BrandingService.getRootContext() %>/angular/<%= appName %>/browser/main<%= CacheService.getNgAppFileHash(appName, 'main', '-') %>.js"
    type="module"></script>
<link rel="stylesheet"
  href="<%= BrandingService.getRootContext() %>/angular/<%= appName %>/browser/styles<%= CacheService.getNgAppFileHash(appName, 'styles', '-') %>.css">
