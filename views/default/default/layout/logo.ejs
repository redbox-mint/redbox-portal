<div class="col-sm-10">
  <div class="logo">
    <% const logoHeadingText = TranslationService.t('logo-heading-text'); %>
    <h1<% if (logoHeadingText && logoHeadingText.trim()) { %> class="logo-with-heading"<% } %>>
      <img src="<%= BrandingService.getBrandAndPortalPath(req) %>/images/logo" alt="<%= TranslationService.t('logo-alt-text') %>"/>
      <% if (logoHeadingText && logoHeadingText.trim()) { %>
        <span class="logo-heading-text"><%= logoHeadingText %></span>
      <% } %>
    </h1>
  </div>
</div>
