<div class="col-sm-10">
  <div class="logo">
    <% const logoHeadingKey = 'logo-heading-text'; %>
    <% const logoHeadingText = TranslationService.t(logoHeadingKey); %>
    <%# t() falls back to the key name when the bundle has no translation, so treat that as "unset" %>
    <% const hasLogoHeadingText = logoHeadingText && logoHeadingText !== logoHeadingKey && logoHeadingText.trim(); %>
    <% const adminPath = BrandingService.getBrandAndPortalPath(req) + '/admin'; %>
    <% const adminLogo = req.path === adminPath || req.path.startsWith(adminPath + '/') || (typeof adminParties !== 'undefined' && adminParties); %>
    <% const logoBrand = BrandingService.getBrand(BrandingService.getBrandNameFromReq(req)); %>
    <% const defaultLogo = !logoBrand?.logo && ['logo.svg', 'logo.png'].includes(sails.config.static_assets.logoName); %>
    <<%= adminLogo ? 'div' : 'h1' %><% if (adminLogo || hasLogoHeadingText) { %> class="<%= [adminLogo ? 'rb-admin-site-logo' : '', hasLogoHeadingText ? 'logo-with-heading' : ''].filter(Boolean).join(' ') %>"<% } %>>
      <img src="<%= BrandingService.getBrandAndPortalPath(req) %>/images/logo" alt="<%= TranslationService.t('logo-alt-text') %>" fetchpriority="high" <% if (defaultLogo) { %>width="171" height="100"<% } %>/>
      <% if (hasLogoHeadingText) { %>
        <span class="logo-heading-text"><%= logoHeadingText %></span>
      <% } %>
    </<%= adminLogo ? 'div' : 'h1' %>>
  </div>
</div>
