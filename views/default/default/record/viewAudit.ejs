<% const resolvedAppName = locals.appName || 'record-audit'; %>
<record-audit
  oid="<%= oid %>"
  branding="<%= branding %>"
  portal="<%= portal %>"
  is-admin="<%= isAdmin ? 'true' : 'false' %>"
  <% if (typeof contentSecurityPolicyNonce !== 'undefined' && contentSecurityPolicyNonce) { %>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
  <div class="col-xs-12">
    <img class="center-block" src="<%= page.root %>/images/loading.svg" alt="<%= page.t('loading-alt-text') %>">
  </div>
</record-audit>

<script src="<%= page.root %>/angular/<%= resolvedAppName %>/browser/main<%= page.bundleHash(resolvedAppName, 'main', '-') %>.js" type="module"></script>
<link rel="stylesheet" href="<%= page.root %>/angular/<%= resolvedAppName %>/browser/styles<%= page.bundleHash(resolvedAppName, 'styles', '-') %>.css">
