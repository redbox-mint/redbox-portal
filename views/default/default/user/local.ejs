<div class="row">
  <local-auth <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
    <div class="col-xs-1">
    </div>
    <div class="col-xs-10">
      <img class="center-block" src="<%= BrandingService.getRootContext() %>/images/loading.svg" alt="<%= TranslationService.t('loading-alt-text') %>">
    </div>
    <div class="col-xs-1">
    </div>
  </local-auth>
</div>
<!-- The Angular polyfills bundle has no imports/exports. Load it as a classic
     script so Zone is installed synchronously before the module bootstrap. -->
<script src="<%= BrandingService.getRootContext() %>/angular/local-auth/browser/polyfills<%=CacheService.getNgAppFileHash('local-auth', 'polyfills', '-') %>.js"></script>
<script src="<%= BrandingService.getRootContext() %>/angular/local-auth/browser/main<%=CacheService.getNgAppFileHash('local-auth', 'main', '-') %>.js" type="module"></script>
