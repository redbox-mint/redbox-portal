
<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">

<head>
  <base href="<%= page.root ? page.root : '/'  %>">
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= typeof description == 'undefined' ? 'ReDBox research data management portal' : description %>">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= page.root %>/apple-touch-icon.png">
  <link rel="icon" href="<%= page.faviconUrl %>" type="image/png">

  <title>
    <%=typeof title == 'undefined' ? page.t('default-title') : title%>
  </title>

  <% /* Brand Typeface: preload Regular once for an active custom typeface, else current Google fonts. */ %>
  <% var __brandTypefaceFont = page.typeface; %>
  <% if (__brandTypefaceFont) { %>
  <link rel="preload" href="<%= __brandTypefaceFont.regularUrl %>" as="font" type="font/woff2" crossorigin>
  <% } else { %>
  <!-- Google Fonts -->
  <link href='https://fonts.googleapis.com/css?family=Titillium+Web:400,200,300,700,600&display=swap' rel='stylesheet' type='text/css'>
  <link href='https://fonts.googleapis.com/css?family=Roboto+Condensed:400,700,300&display=swap' rel='stylesheet' type='text/css'>
  <link href='https://fonts.googleapis.com/css?family=Raleway:400,100&display=swap' rel='stylesheet' type='text/css'>
  <% } %>


  <!-- Custom CSS -->
  <link rel="stylesheet" href="<%= page.base %>/styles/style.min.css">
  <% if (req.query && req.query.previewToken) { %>
    <link rel="stylesheet" href="<%= page.base %>/preview/<%= req.query.previewToken %>.css">
  <% } else { %>
  <% /* Theme CSS is versioned by the publication hash so a republish applies immediately instead of waiting out the browser cache. */ %>
  <% var __themeBrand = page.brand; %>
  <% var __themeCssVer = (__themeBrand && __themeBrand.hash) ? ('?v=' + __themeBrand.hash) : ''; %>
  <link rel="stylesheet" href="<%= page.base %>/styles/theme.css<%= __themeCssVer %>">
  <% } %>
  <!-- Hook extension point: renders nothing unless a hook overrides /layout/head-extra.ejs -->
  <%- superPartial("/layout/head-extra.ejs",
       typeof branding !== 'undefined' && branding != null ? branding : page.brand.name,
       typeof portal !== 'undefined' && portal != null ? portal : page.portal, true) %>
  <!-- Print stylesheet served as a static asset so it can be updated independently of the
       MongoDB-cached theme.css (which only refreshes on admin republish). -->
  <link rel="stylesheet" media="print" href="<%= page.root %>/styles/print.css">

  <!-- Current latest jQuery -->
  <script src="<%= page.base %>/js/jquery.min.js" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>nonce="<%= contentSecurityPolicyNonce %>"<% } %>></script>
  <!-- Current latest Bootstrap JS  -->
  <script src="<%= page.base %>/js/bootstrap.bundle.min.js" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>nonce="<%= contentSecurityPolicyNonce %>"<% } %>></script>
  <script src="<%= page.base %>/js/index.bundle.js" data-redbox-root="<%= page.root %>" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>nonce="<%= contentSecurityPolicyNonce %>"<% } %>></script>


    <angular-bootstrap rootContext="<%= page.root %>" ></angular-bootstrap>

    <!-- Branding-aware web analytics (loader scripts) -->
    <%- include('analytics', { position: 'head' }) %>
</head>

<body>
  <!-- Branding-aware web analytics (noscript fallback) -->
  <%- include('analytics', { position: 'body' }) %>
  <div class="header-area">
    <div class="container">
      <div class="row">
        <div class="col-md-8">
          <div class="user-menu">
            <ul>
              <% if (!req.isAuthenticated())  { %>
                <li><a href="<%= page.base %>/user/login"><i class="fa fa-user"></i><%= page.t('menu-login') %></a></li>
              <% } else { %>
                <li><i class="fa fa-user"></i>&nbsp;<%= page.t('menu-welcome-text') %>
                  <%= req.user.name %>
                </li>
                <li><form class="redbox-logout" method="post" action="<%= page.base %>/user/logout">
                  <input type="hidden" name="_csrf" value="<%= typeof _csrf !== 'undefined' ? _csrf : '' %>">
                  <button type="submit" class="btn btn-link"><%= page.t('menu-logout') %></button>
                </form></li>
              <% } %>

            </ul>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mt-3" >
            <div class="dropdown pull-right">
                <%
                  // Use available languages from the i18nLanguages policy
                  const languages = (typeof availableLanguages !== 'undefined' && availableLanguages) ? availableLanguages : [{ code: 'en', displayName: 'English' }];
                  if (languages.length > 1) {
                    // Find current language display name
                    const currentLang = languages.find(l => l.code === lang) || languages[0];
                  %>
                  <a class="dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                    <%= currentLang.displayName %>
                  </a>
                  <ul class="dropdown-menu">
                    <%
                    for (const language of languages) {
                      if (language.code !== lang) {
                        const langUrl = new URL(req.originalUrl, page.origin);
                        const params = new URLSearchParams(langUrl.search);
                        params.set('lng', language.code);
                        langUrl.search = params;
                        %>
                        <li><a class="dropdown-item" href="<%= langUrl.pathname + langUrl.search %>"><%= language.displayName %></a></li>
                        <%
                      }
                    }
                  %>
                  </ul>
                    <%
                  }
                %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- End header area -->

  <div class="site-branding-area">
    <div class="container">
      <div class="row">
        <% if(typeof branding !== 'undefined' && branding != null && typeof portal !== 'undefined' && portal != null) { %>
        <%- superPartial("/layout/logo.ejs", branding, portal, true) %>
        <% } else { %>
          <%- include('layout/logo.ejs') %>
        <%}%>

        <div class="col-sm-2 search-box">
        </div>
      </div>
    </div>
  </div>
  <!-- End site branding area -->
  <% if(typeof branding !== 'undefined' && branding != null && typeof portal !== 'undefined' && portal != null) { %>
  <%- superPartial("/layout/menu.ejs", branding, portal, true) %>
    <% } else { %>
    <%- include('layout/menu.ejs') %>
    <%}%>
  <!-- End mainmenu area -->
<% if (typeof title!== 'undefined') { %>
<% } %>

<%
  var brandingName = branding;
  var portalName = portal;
  var systemMessageConfig = page.settings.systemMessage || {};
  // We use FNV-1a hash to generate a short, value-based identifier for the system message content.
  // This is used to track changes in the system message content and only re-render the message when it changes as it's light and fast and collisions aren't a huge concern.
  function fnv1aHash(str) {
    var hash = 2166136261;
    for (var i = 0; i < str.length; i++) {
      hash ^= str.charCodeAt(i);
      hash = Math.imul(hash, 16777619);
    }
    return ('0000000' + (hash >>> 0).toString(16)).slice(-8);
  }
  var dismissalDurationHours = systemMessageConfig.dismissalDurationHours ?? 8;
  var rawSystemMessageKey = JSON.stringify({
    title: systemMessageConfig.title || '',
    message: systemMessageConfig.message || '',
    dismissalDurationHours: dismissalDurationHours
  });
  var systemMessageKey = fnv1aHash(rawSystemMessageKey);
  var systemMessageScope = brandingName + ':' + portalName;
%>
<% if (systemMessageConfig.enabled === true) { %>
  <div id="system-message-area" class="container"
    data-system-message-key="<%= systemMessageKey %>"
    data-system-message-scope="<%= systemMessageScope %>"
    data-system-message-dismissal-hours="<%= dismissalDurationHours %>">
  <div id="system-message" class="alert alert-primary<% if (dismissalDurationHours > 0) { %> alert-dismissible<% } %> fade show" role="alert">
    <h4><%- systemMessageConfig.title || '' %></h4>
    <div><%- systemMessageConfig.message || '' %></div>
    <% if (dismissalDurationHours > 0) { %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    <% } %>
  </div>
</div>
 <% } %>

  <div class="maincontent-body">
    <%- body %>
  </div>



  <div class="footer-bottom-area navbar-bottom">
    <% if(typeof branding !== 'undefined' && branding != null && typeof portal !== 'undefined' && portal != null) { %>
      <%- superPartial("/layout/footer.ejs", branding, portal, true) %>
      <% } else { %>
        <%- include('layout/footer.ejs') %>
      <%}%>

  </div>



</body>
</html>
