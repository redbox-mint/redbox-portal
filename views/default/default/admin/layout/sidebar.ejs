<%
  const sidebar = typeof adminSidebar !== 'undefined' && adminSidebar ? adminSidebar : { sections: [], footerLinks: [] };
  const overviewHref = BrandingService.getBrandAndPortalPath(req) + '/admin';
  const activeSection = (sidebar.sections || []).find(section => section.items.some(item => item.active));
  const activeItem = activeSection ? activeSection.items.find(item => item.active) : (sidebar.footerLinks || []).find(item => item.active);
  const overviewActive = req.path.replace(/\/$/, '') === overviewHref;
%>
<aside class="rb-admin-sidebar" aria-label="<%= TranslationService.t('admin-navigation-label') %>">
  <button type="button" class="rb-admin-sidebar-toggle" aria-expanded="false" aria-controls="rb-admin-navigation" data-admin-toggle>
    <span><%= TranslationService.t('admin-menu-disclosure') %><small><%= activeSection ? activeSection.title + ' / ' : '' %><%= activeItem ? activeItem.label : TranslationService.t('admin-overview') %></small></span>
    <i class="fa fa-chevron-down" aria-hidden="true"></i>
  </button>
  <div id="rb-admin-navigation" class="rb-admin-sidebar-content">
  <div class="rb-admin-sidebar-search">
    <i class="fa fa-search" aria-hidden="true"></i>
    <input type="search" class="form-control" aria-label="<%= TranslationService.t('admin-setting-filter') %>" placeholder="<%= TranslationService.t('admin-setting-filter') %>" data-admin-filter>
  </div>
  <nav aria-label="<%= TranslationService.t('admin-sidebar-navigation-label') %>">
    <a class="rb-admin-sidebar-item rb-admin-sidebar-home<%= overviewActive ? ' active' : '' %>" href="<%= overviewHref %>" <% if (overviewActive) { %>aria-current="page"<% } %> data-admin-filter-item>
      <i class="fa fa-home" aria-hidden="true"></i> <%= TranslationService.t('admin-overview') %>
    </a>
    <% (sidebar.sections || []).forEach(function(section, sectionIndex) { %>
      <section class="rb-admin-sidebar-section" data-admin-filter-section>
        <div class="rb-admin-sidebar-heading" id="admin-nav-group-<%= sectionIndex %>"><%= section.title %></div>
        <ul class="rb-admin-sidebar-list" aria-labelledby="admin-nav-group-<%= sectionIndex %>">
        <% section.items.forEach(function(item) { %>
          <li><a class="rb-admin-sidebar-item<%= item.active ? ' active' : '' %>" href="<%= item.href %>" <% if (item.active) { %>aria-current="page"<% } %> <% if (item.external) { %>target="<%= item.target || '_blank' %>" rel="noopener noreferrer"<% } %> data-admin-filter-item><%= item.label %></a></li>
        <% }); %>
        </ul>
      </section>
    <% }); %>
    <% (sidebar.footerLinks || []).forEach(function(item) { %>
      <a class="rb-admin-sidebar-item<%= item.active ? ' active' : '' %>" href="<%= item.href %>" <% if (item.active) { %>aria-current="page"<% } %> <% if (item.external) { %>target="<%= item.target || '_blank' %>" rel="noopener noreferrer"<% } %> data-admin-filter-item><%= item.label %></a>
    <% }); %>
  </nav>
  <p class="rb-admin-sidebar-no-results" role="status" hidden><%= TranslationService.t('admin-setting-no-results') %></p>
  </div>
</aside>
<script <% if (typeof contentSecurityPolicyNonce !== 'undefined' && contentSecurityPolicyNonce) { %>nonce="<%= contentSecurityPolicyNonce %>"<% } %>>
(function () {
  const sidebar = document.querySelector('.rb-admin-sidebar');
  const input = sidebar.querySelector('[data-admin-filter]');
  const toggle = sidebar.querySelector('[data-admin-toggle]');
  toggle.addEventListener('click', function () {
    const expanded = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(expanded));
    sidebar.classList.toggle('is-expanded', expanded);
  });
  sidebar.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      toggle.setAttribute('aria-expanded', 'false');
      sidebar.classList.remove('is-expanded');
      toggle.focus();
    }
  });
  input.addEventListener('input', function () {
    const query = input.value.trim().toLocaleLowerCase();
    let matches = 0;
    sidebar.querySelectorAll('[data-admin-filter-item]').forEach(function (item) {
      const section = item.closest('[data-admin-filter-section]');
      const heading = section ? section.querySelector('.rb-admin-sidebar-heading').textContent : '';
      item.hidden = !(item.textContent + ' ' + heading).toLocaleLowerCase().includes(query);
      if (item.parentElement.tagName === 'LI') item.parentElement.hidden = item.hidden;
      if (!item.hidden) matches++;
    });
    sidebar.querySelectorAll('[data-admin-filter-section]').forEach(function (section) {
      section.hidden = !section.querySelector('[data-admin-filter-item]:not([hidden])');
    });
    sidebar.querySelector('[role="status"]').hidden = matches > 0;
  });
})();
</script>
