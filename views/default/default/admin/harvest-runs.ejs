<% let appName = 'harvest-runs';
const earlyHeader = {
  title: TranslationService.t('harvest-runs-heading'),
  description: TranslationService.t('admin-harvest-description'),
  adminLabel: TranslationService.t('menu-admin'),
  breadcrumbLabel: TranslationService.t('admin-breadcrumb-label'),
  section: TranslationService.t('admin-nav-records'),
  refresh: TranslationService.t('export-refresh'),
  adminUrl: BrandingService.getBrandAndPortalPath(req) + '/admin'
};
%>
<%- include('layout/start.ejs') %>
    <harvest-runs data-admin-header="<%= JSON.stringify(earlyHeader) %>" <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>ngCspNonce="<%= contentSecurityPolicyNonce %>"<% } %>>
      <%- include('layout/early-header.ejs', { header: earlyHeader }) %>
      <div class="col-xs-12">
        <img class="center-block" src="<%= BrandingService.getRootContext() %>/images/loading.svg" alt="<%= TranslationService.t('loading-alt-text') %>">
      </div>
    </harvest-runs>
<%- include('layout/end.ejs') %>
<script src="<%= BrandingService.getRootContext() %>/angular/<%= appName %>/browser/polyfills<%= CacheService.getNgAppFileHash(appName, 'polyfills', '-') %>.js"
   type="module"></script>

<script src="<%= BrandingService.getRootContext() %>/angular/<%= appName %>/browser/main<%= CacheService.getNgAppFileHash(appName, 'main', '-') %>.js"
   type="module"></script>
<link rel="stylesheet" href="<%= BrandingService.getRootContext() %>/angular/<%= appName %>/browser/styles<%= CacheService.getNgAppFileHash(appName, 'styles', '-') %>.css">
