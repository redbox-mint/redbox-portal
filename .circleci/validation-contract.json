      "junit": [],
      "artifacts": []
    },
    "test-redbox-dev-tools-cli": {
      "runs": [
        {
          "name": "Run hook-kit CLI tests with coverage",
          "no_output_timeout": "30m",
          "command": "nvm install\ncd ./packages/redbox-dev-tools\nmkdir -p coverage/redbox-dev-tools\nmkdir -p support/junit\nstatus=0\nTS_NODE_PROJECT=test/tsconfig.json ../../node_modules/.bin/nyc --no-clean --report-dir ./coverage/redbox-dev-tools --reporter=lcov --exclude-after-remap=false \\\n  npm test || status=$?\nif [ \"$status\" -ne 0 ]; then\n  echo \"redbox-dev-tools tests failed with status $status\"\n  echo \"----- support/junit/mocha.xml -----\"\n  cat support/junit/mocha.xml || true\n  echo \"----- re-running with spec reporter for diagnostics -----\"\n  CI=false TS_NODE_PROJECT=test/tsconfig.json node -r ts-node/register ./node_modules/mocha/bin/_mocha --exit test/**/*.test.ts || true\nfi\nexit \"$status\"\n"
        },
        {
          "name": "Upload redbox-dev-tools CLI code coverage",
          "command": "cd ./packages/redbox-dev-tools\nnode ../../support/unit-testing/codecov/prepare-report.cjs \\\n  \"./coverage/redbox-dev-tools/lcov.info\" \"packages/redbox-dev-tools\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-redbox-dev-tools-cli\" --file \"./coverage/redbox-dev-tools/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
        }
      ],
      "junit": [
        "packages/redbox-dev-tools/support/junit"
      ],
      "artifacts": []
    },
    "test-storage-mongo": {
      "runs": [
        {
          "name": "Test Agenda watchdog cleanup with real MongoDB and SQS repository jobs",
          "command": "AGENDA_TEST_MONGO_URL=\"$MONGO_TEST_URL/agenda_watchdog\" npm run test:agenda-watchdog"
