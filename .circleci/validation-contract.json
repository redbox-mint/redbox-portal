    "test-rva-registry": {
      "runs": [
        {
          "name": "Run deterministic RVA registry client tests with coverage",
          "command": "cd ./packages/rva-registry\nnpm run test:coverage\n"
        },
        {
          "name": "Upload RVA registry code coverage",
          "command": "cd ./packages/rva-registry\nnode ../../support/unit-testing/codecov/prepare-report.cjs \\\n  \"./coverage/rva-registry/lcov.info\" \"packages/rva-registry\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-rva-registry\" --file \"./coverage/rva-registry/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
