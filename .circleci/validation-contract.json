{
  "description": "Pre-scheduling suite commands (including failure and coverage behavior), reports, matrices, and event filters. New release Playwright and validation gate are tested separately.",
  "tests": {
    "test-bruno-general": {
      "runs": [
        {
          "name": "Run Bruno General tests",
          "no_output_timeout": "30m",
          "command": "BRUNO_POST_SLEEP_SECONDS=180 timeout 1800s npm run test:bruno:general:ci"
        },
        {
          "name": "Upload Bruno General code coverage",
          "command": "sudo chmod -R a+rwX ./coverage\nnode support/unit-testing/codecov/prepare-report.cjs \"./coverage/bruno-general/lcov.info\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-bruno-general\" --file \"./coverage/bruno-general/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
        }
      ],
      "junit": [
        ".tmp/junit"
      ],
      "artifacts": []
    },
    "test-bruno-oidc": {
      "runs": [
        {
          "name": "Run Bruno OIDC tests",
          "no_output_timeout": "30m",
          "command": "BRUNO_POST_SLEEP_SECONDS=180 timeout 1800s npm run test:bruno:oidc:ci"
        },
        {
          "name": "Upload Bruno OIDC code coverage",
          "command": "sudo chmod -R a+rwX ./coverage\nnode support/unit-testing/codecov/prepare-report.cjs \"./coverage/bruno-oidc/lcov.info\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-bruno-oidc\" --file \"./coverage/bruno-oidc/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
        }
      ],
      "junit": [
        ".tmp/junit"
      ],
      "artifacts": []
    },
    "test-bruno-s3": {
      "runs": [
        {
          "name": "Run Bruno S3 attachment storage tests",
          "no_output_timeout": "30m",
          "command": "BRUNO_POST_SLEEP_SECONDS=180 timeout 1800s npm run test:bruno:s3:ci"
        },
        {
          "name": "Upload Bruno S3 code coverage",
          "command": "sudo chmod -R a+rwX ./coverage\nnode support/unit-testing/codecov/prepare-report.cjs \"./coverage/bruno-s3/lcov.info\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-bruno-s3\" --file \"./coverage/bruno-s3/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
        }
      ],
      "junit": [
        ".tmp/junit"
      ],
      "artifacts": []
    },
    "test-playwright": {
      "runs": [
        {
          "name": "Run Playwright browser smoke tests",
          "no_output_timeout": "30m",
          "command": "timeout 1800s npm run test:playwright:ci"
        },
        {
          "name": "Upload Playwright code coverage",
          "command": "sudo chmod -R a+rwX ./coverage\nnode support/unit-testing/codecov/prepare-report.cjs \"./coverage/playwright/lcov.info\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-playwright\" --file \"./coverage/playwright/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
