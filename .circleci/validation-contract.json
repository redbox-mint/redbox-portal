      ],
      "artifacts": [
        ".tmp/playwright"
      ]
    },
    "test-mocha": {
      "runs": [
        {
          "name": "Run Mocha tests",
          "no_output_timeout": "30m",
          "command": "timeout 1800s npm run test:mocha:ci"
        },
        {
          "name": "Upload Mocha code coverage",
          "command": "sudo chmod -R a+rwX ./coverage\nnode support/unit-testing/codecov/prepare-report.cjs \"./coverage/mocha/lcov.info\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-mocha\" --file \"./coverage/mocha/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
        }
      ],
      "junit": [
        ".tmp/junit"
      ],
      "artifacts": []
    },
    "test-angular": {
      "runs": [
        {
          "name": "Run Angular tests",
          "no_output_timeout": "30m",
          "command": "chmod +x support/unit-testing/angular/testAngular.sh\nsource support/unit-testing/angular/testAngular.sh \"<< parameters.angular_app >>\"\n"
        }
      ],
      "junit": [
        ".tmp/junit"
      ],
      "artifacts": []
    },
    "test-sails-ng-common": {
      "runs": [
        {
          "name": "Run Mocha tests",
          "no_output_timeout": "30m",
          "command": "cd ./packages/sails-ng-common\nnpm run test:compile\nnpm run test:prepare\nnpx nyc --no-clean --report-dir ./coverage/sails-ng-common --reporter=lcov --exclude-after-remap=false \\\n  npx mocha --config test/unit/.mocharc.js --exit dist/test/unit/**/*.test.js\n"
        },
        {
          "name": "Upload Mocha code coverage",
          "command": "cd ./packages/sails-ng-common\nnode ../../support/unit-testing/codecov/prepare-report.cjs \\\n  \"./coverage/sails-ng-common/lcov.info\" \"packages/sails-ng-common\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-sails-ng-common\" --file \"./coverage/sails-ng-common/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
        }
      ],
      "junit": [
        "packages/sails-ng-common/support/junit"
      ],
      "artifacts": []
    },
    "test-redbox-core": {
      "runs": [
        {
          "name": "Type-check Effect integrations and tests",
          "command": "nvm install && npm --prefix packages/redbox-core run typecheck:effect"
        },
        {
          "name": "Verify record-contract coverage",
          "command": "nvm install && npm run test:record-contracts"
        },
        {
          "name": "Run Mocha tests with coverage",
          "no_output_timeout": "30m",
          "command": "cd ./packages/redbox-core\nmkdir -p support/junit\nnvm install && npx nyc --no-clean --report-dir ./coverage/redbox-core --reporter=lcov --exclude-after-remap=false \\\n  npx mocha --config .mocharc.js --exit test/**/*.test.ts\n"
        },
        {
          "name": "Upload redbox-core code coverage",
          "command": "cd ./packages/redbox-core\nnode ../../support/unit-testing/codecov/prepare-report.cjs \\\n  \"./coverage/redbox-core/lcov.info\" \"packages/redbox-core\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-redbox-core\" --file \"./coverage/redbox-core/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
        }
      ],
      "junit": [
        "packages/redbox-core/support/junit"
      ],
      "artifacts": []
    },
    "test-agenda-sqs-backend": {
      "runs": [
        {
          "name": "Run agenda SQS backend tests with coverage",
          "command": "cd ./packages/agenda-sqs-backend\nnpm run test:coverage\n"
        },
        {
          "name": "Upload agenda SQS backend code coverage",
          "command": "cd ./packages/agenda-sqs-backend\nnode ../../support/unit-testing/codecov/prepare-report.cjs \\\n  \"./coverage/agenda-sqs-backend/lcov.info\" \"packages/agenda-sqs-backend\"\n/tmp/.codecov-cli/codecov --verbose upload-process --fail-on-error --disable-search \\\n --network-root-folder \"$(git rev-parse --show-toplevel)\" \\\n --token \"${CODECOV_TOKEN}\" --name \"job-${CIRCLE_BUILD_NUM}-${CIRCLE_TAG:-$CIRCLE_BRANCH}\" \\\n --flag \"backend-agenda-sqs\" --file \"./coverage/agenda-sqs-backend/lcov.info\" --branch \"${CIRCLE_TAG:-$CIRCLE_BRANCH}\"\n",
          "when": "always"
