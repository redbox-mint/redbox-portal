{
  "name": "@researchdatabox/rva-registry-openapi-generated-node",
  "version": "0.0.1",
  "description": "Autogenerated client for ARDC Vocabulary Registry (RVA)",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "npm run test:unit",
    "pretest:unit": "npm run build",
    "test:unit": "mocha -r ts-node/register test/unit/**/*.spec.ts",
    "pretest:live": "npm run build",
    "test:live": "mocha -r ts-node/register test/live/**/*.spec.ts",
    "test:coverage": "npm run build && nyc --all --include 'dist/**/*.js' --report-dir coverage/rva-registry --reporter=lcov --reporter=text --exclude-after-remap=false mocha -r ts-node/register test/unit/**/*.spec.ts",
    "pregenerate": "npm install @openapitools/openapi-generator-cli -g",
    "generate": "openapi-generator-cli generate -i ../../rva-swagger.json -g typescript-axios -o ./src",
    "build": "tsc"
  },
  "author": "QCIF Engineering",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/old": "npm:typescript@6.0.2",
    "mocha": "11.8.0",
    "nyc": "18.0.0",
    "ts-node": "10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "axios": "1.19.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  }
}
