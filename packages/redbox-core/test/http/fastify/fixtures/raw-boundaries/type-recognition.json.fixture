{
  "cases": [
    {
      "id": "readable-promise-return",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare function open(): Promise<StreamAlias>; async function produce() { return open(); }",
      "expectedKind": "typed-return",
      "operation": "return",
      "expectedReceiver": "open()"
    },
    {
      "id": "readable-promise-arrow",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare function open(): Promise<StreamAlias>; const produce = () => open();",
      "expectedKind": "typed-return",
      "operation": "arrow-return",
      "expectedReceiver": "open()"
    },
    {
      "id": "readable-promiselike-return",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare function open(): PromiseLike<StreamAlias>; function produce() { return open(); }",
      "expectedKind": "typed-return",
      "operation": "return",
      "expectedReceiver": "open()"
    },
    {
      "id": "readable-nested-return",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare function open(): PromiseLike<Promise<UnionAlias>>; function produce() { return open(); }",
      "expectedKind": "typed-return",
      "operation": "return",
      "expectedReceiver": "open()"
    },
    {
      "id": "readable-promise-handoff",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare const pending: Promise<UnionAlias>; accept(pending);",
      "expectedKind": "typed-handoff",
      "operation": "accept",
      "expectedReceiver": "pending"
    },
    {
      "id": "readable-promiselike-handoff",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare const pending: PromiseLike<StreamAlias>; accept(pending);",
      "expectedKind": "typed-handoff",
      "operation": "accept",
      "expectedReceiver": "pending"
    },
    {
      "id": "readable-promise-receiver",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare const pending: Promise<StreamAlias>; pending.then(value => value);",
      "expectedKind": "typed-call",
      "operation": "then",
      "expectedReceiver": "pending"
    },
    {
      "id": "readable-promise-write",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare const pending: Promise<StreamAlias>; pending.then = pending.then;",
      "expectedKind": "typed-property-write",
      "operation": "then",
      "expectedReceiver": "pending"
    },
    {
      "id": "readable-awaited-handoff",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare const resolved: Awaited<PromiseLike<UnionAlias>>; accept(resolved);",
      "expectedKind": "typed-handoff",
      "operation": "accept",
      "expectedReceiver": "resolved"
    },
    {
      "id": "readable-generic-return",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; function produce<T extends PromiseLike<StreamAlias>>(pending: T) { return pending; }",
      "expectedKind": "typed-return",
      "operation": "return",
      "expectedReceiver": "pending"
    },
    {
      "id": "readable-promise-iteration",
      "scope": "services",
      "source": "type StreamAlias = Readable; type UnionAlias = StreamAlias | undefined; declare const pending: Promise<Readable>; async function consume() { for await (const chunk of pending) void chunk; }",
      "expectedKind": "typed-iteration",
      "operation": "for-await",
      "expectedReceiver": "pending"
    },
