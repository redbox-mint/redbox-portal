import type { IncomingMessage, ServerResponse, Server, RequestListener } from 'node:http';
import type { Socket as NetSocket } from 'node:net';
import type { Duplex, Readable, Writable, Transform, PassThrough } from 'node:stream';
import { Readable as NodeReadable, pipeline as callbackPipeline, finished as callbackFinished, compose, addAbortSignal } from 'node:stream';
import { pipeline as promisePipeline, finished as promiseFinished } from 'node:stream/promises';
import { once as eventOnce, on as eventOn, addAbortListener } from 'node:events';
import * as nodeStreams from 'node:stream';
import * as streamPromises from 'node:stream/promises';
import * as nodeEvents from 'node:events';
import type * as Companion from '@uppy/companion';
import type { EventEmitter } from 'node:events';
import type { Request, Response } from 'express';
import type { FastifyReply, FastifyRequest } from 'fastify';
import type { Server as ProgressServer, Socket as ProgressSocket } from 'socket.io';
declare const reply: FastifyReply;
declare const request: IncomingMessage & { raw: IncomingMessage };
declare const req: Request;
declare const res: Response, response: ServerResponse;
declare const socket: NetSocket;
declare const raw: Duplex;
declare const stream: Readable, arbitrary: Duplex, parser: Writable;
declare const server: Server, emitter: EventEmitter, bridge: EventEmitter, io: ProgressServer;
declare const progressSocket: ProgressSocket, progress: ProgressServer;
declare const controller: AbortController, signal: AbortSignal;
declare const native: {request: FastifyRequest; reply: FastifyReply};
declare const requests: Map<Promise<void>, Duplex>, promise: Promise<void>;
declare const handler: RequestListener, listener: RequestListener, dispatch: RequestListener;
declare const callback: (...args: unknown[]) => void, cancel: () => void, finish: () => void, check: () => void;
declare const event: string, bytes: Uint8Array, chunk: Uint8Array, error: Error, delay: number, head: Buffer;
declare const timer: ReturnType<typeof setTimeout>, wrapper: ServerResponse['end'];
declare function foo(value: unknown): void;
declare function accept(value: unknown, options?: { signal: AbortSignal }): void;
declare class Holder { constructor(value: unknown); }
declare const callbackError: (error?: Error | null) => void;
