  "forms": [
    {
      "id": "for-await",
      "kind": "typed-iteration",
      "operation": "for-await",
      "source": "async function consume() { for await (const chunk of $candidate) void chunk; }",
      "requires": "async-iterable",
      "inapplicable": "No direct async byte iterator on a writable-only stream, pure emitter/server, reply or abort owner; use eventOn iteration/local handoff instead."
    },
    {
      "id": "async-iterator",
      "kind": "typed-call",
      "operation": "<computed>",
      "source": "$candidate[Symbol.asyncIterator]();",
      "requires": "async-iterable",
      "inapplicable": "No direct Symbol.asyncIterator on this family; eventOn supplies emitter iteration where applicable."
    },
    {
      "id": "iterator-method",
      "kind": "typed-call",
      "operation": "iterator",
      "source": "$candidate.iterator({ destroyOnReturn: false });",
      "requires": "iterator",
      "inapplicable": "The family does not expose the Node Readable.iterator method; explicit asyncIterator or events iteration covers its valid iterator path."
    },
    {
      "id": "for-of-container",
      "kind": "typed-iteration",
      "operation": "for-of",
      "source": "for (const value of [$candidate]) accept(value);",
      "receiver": "[$candidate]"
    },
    {
      "id": "yield-delegation",
      "kind": "typed-delegation",
      "operation": "yield*",
      "source": "async function* consume() { yield* $candidate; }",
      "requires": "async-iterable",
      "inapplicable": "Direct yield* byte delegation requires an iterable; emitter iteration uses eventOn."
    },
    {
      "id": "pipeline-callback",
      "kind": "typed-handoff",
      "operation": "callbackPipeline",
      "source": "callbackPipeline($pipeline, callbackError);",
      "requires": "pipeline",
      "inapplicable": "Pipeline requires byte streams/iterables; a pure emitter/server/abort owner is not a byte pipeline. Fastify uses its raw stream."
    },
    {
      "id": "pipeline-promise",
      "kind": "typed-handoff",
      "operation": "promisePipeline",
      "source": "promisePipeline($pipeline);",
      "requires": "pipeline",
      "inapplicable": "Pipeline requires byte streams/iterables; a pure emitter/server/abort owner is not a byte pipeline. Fastify uses its raw stream."
    },
    {
      "id": "finished-callback",
      "kind": "typed-handoff",
      "operation": "callbackFinished",
      "source": "callbackFinished($candidate, callbackError);",
      "requires": "node-stream",
      "inapplicable": "Callback stream.finished requires a Node stream; this family uses event observation or its own completion API."
    },
    {
      "id": "finished-promise",
      "kind": "typed-handoff",
      "operation": "promiseFinished",
      "source": "promiseFinished($candidate);",
      "requires": "node-stream",
      "inapplicable": "Promise finished cases use Node streams; Web stream completion is separately tested via finished-web."
    },
    {
      "id": "finished-web",
      "kind": "typed-handoff",
      "operation": "promiseFinished",
      "source": "promiseFinished($candidate);",
      "requires": "abortable",
      "inapplicable": "This form is specific to Web readable streams; Node stream finished has its own row."
    },
    {
      "id": "readable-from",
      "kind": "typed-handoff",
      "operation": "from",
      "source": "NodeReadable.from($candidate);",
      "requires": "async-iterable",
      "inapplicable": "Readable.from requires an iterable; pure emitters use eventOn, and writable-only families are destinations."
    },
    {
      "id": "compose",
      "kind": "typed-handoff",
      "operation": "compose",
      "source": "compose($candidate, parser);",
      "requires": "compose-source",
      "inapplicable": "Composition needs a readable source; pure emitters and writable-only families have other observation/handoff forms."
    },
    {
      "id": "add-abort-signal",
      "kind": "typed-handoff",
      "operation": "addAbortSignal",
      "source": "addAbortSignal(controller.signal, $candidate);",
      "requires": "node-stream",
      "inapplicable": "This row wires Node streams; Web-specific addAbortSignal is covered separately; non-stream families use signal options/listeners."
    },
    {
      "id": "add-abort-signal-web",
      "kind": "typed-handoff",
      "operation": "addAbortSignal",
      "source": "addAbortSignal(controller.signal, $candidate);",
      "requires": "abortable",
      "inapplicable": "Specific Web stream cancellation wiring; Node addAbortSignal has its own row."
    },
    {
      "id": "events-on",
      "kind": "typed-handoff",
      "operation": "eventOn",
      "source": "eventOn($candidate, 'data');",
      "requires": "emitter",
      "inapplicable": "Pure Web streams, Fastify facades and abort controllers are not EventEmitters; raw transports are tested and AbortSignal uses the EventTarget row."
    },
    {
      "id": "events-on-iteration",
      "kind": "typed-iteration",
      "operation": "for-await",
      "source": "async function consume() { for await (const value of eventOn($candidate, 'data')) accept(value); }",
      "requires": "emitter",
      "inapplicable": "No emitter event API on this family; direct stream iteration or EventTarget form applies instead.",
      "receiver": "eventOn($candidate, 'data')"
    },
    {
      "id": "events-on-target",
      "kind": "typed-handoff",
      "operation": "eventOn",
      "source": "eventOn($candidate, 'abort');",
      "requires": "event-target",
      "inapplicable": "Specific EventTarget/AbortSignal event observation; emitter events.on has its own row."
    },
    {
      "id": "events-once",
      "kind": "typed-handoff",
      "operation": "eventOnce",
      "source": "eventOnce($candidate, 'close');",
      "requires": "emitter",
      "inapplicable": "No emitter event API on this family; AbortSignal EventTarget once is tested separately."
    },
    {
      "id": "events-once-target",
      "kind": "typed-handoff",
      "operation": "eventOnce",
      "source": "eventOnce($candidate, 'abort');",
      "requires": "event-target",
      "inapplicable": "Specific EventTarget/AbortSignal once observation; emitter events.once has its own row."
    },
    {
      "id": "pipe-source",
      "kind": "typed-call",
      "operation": "pipe",
      "source": "$candidate.pipe(parser);",
      "requires": "node-readable",
      "inapplicable": "No Node pipe source API on writable-only/pure emitter/Web/abort families; use their supported consuming APIs."
    },
    {
      "id": "pipe-target",
      "kind": "typed-handoff",
      "operation": "pipe",
      "source": "stream.pipe($candidate);",
      "requires": "node-writable",
      "inapplicable": "This family is not a Node writable destination; readable-source and generic function handoff forms are tested."
    },
    {
      "id": "local-argument",
      "kind": "typed-handoff",
      "operation": "accept",
      "source": "accept($candidate);"
    },
    {
      "id": "constructor-argument",
      "kind": "typed-handoff",
      "operation": "Holder",
      "source": "new Holder($candidate);"
    },
    {
      "id": "explicit-return",
      "kind": "typed-return",
      "operation": "return",
      "source": "function produce() { return $candidate; }"
    },
    {
      "id": "arrow-return",
      "kind": "typed-return",
      "operation": "arrow-return",
      "source": "const produce = () => $candidate;"
    },
    {
      "id": "aggregate-return",
      "kind": "typed-return",
      "operation": "return",
      "source": "function produce() { const result = { body: $candidate }; return result; }",
      "receiver": "result"
    },
    {
      "id": "aggregate-argument",
      "kind": "typed-handoff",
      "operation": "accept",
      "source": "accept({ body: $candidate });",
      "receiver": "{ body: $candidate }"
    },
    {
      "id": "spread-argument",
      "kind": "typed-handoff",
      "operation": "accept",
      "source": "const args = [$candidate] as const; accept(...args);",
      "receiver": "...args"
    },
    {
      "id": "signal-options",
      "kind": "typed-handoff",
      "operation": "accept",
      "source": "accept($candidate, { signal: controller.signal });"
    },
    {
      "id": "abort-destroy",
      "kind": "typed-call",
      "operation": "destroy",
      "source": "signal.addEventListener('abort', () => $candidate.destroy());",
      "requires": "destroyable",
      "inapplicable": "Interface-only streams may not declare destroy; their addAbortSignal or signal options wiring remains inventoried."
    },
    {
      "id": "abort-listener",
      "kind": "typed-handoff",
      "operation": "addAbortListener",
      "source": "addAbortListener($candidate, finish);",
      "requires": "event-target",
      "inapplicable": "addAbortListener accepts AbortSignal; other families are wired by signal options/addAbortSignal/abort-destroy."
    },
    {
      "id": "pipeline-namespace",
      "kind": "typed-handoff",
      "operation": "pipeline",
      "source": "nodeStreams.pipeline($pipeline, callbackError);",
      "requires": "pipeline",
      "inapplicable": "This API belongs to the indicated byte-stream family; other families use their applicable consume/handoff APIs."
    },
    {
      "id": "pipeline-promise-namespace",
