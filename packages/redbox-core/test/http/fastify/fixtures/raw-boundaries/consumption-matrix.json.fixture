    {
      "id": "asserted-return",
      "kind": "typed-return",
      "operation": "return",
      "source": "declare const erased: unknown; function produce() { return erased as typeof $candidate; }",
      "receiver": "erased as typeof $candidate"
    },
    {
      "id": "iterator-next",
      "kind": "typed-call",
      "operation": "next",
      "source": "const iterator = $candidate[Symbol.asyncIterator](); iterator.next();",
