    },
    {
      "id": "conditional-return",
      "kind": "typed-return",
      "operation": "return",
      "source": "function produce(flag: boolean) { return flag ? $candidate : undefined; }",
      "receiver": "flag ? $candidate : undefined"
    },
    {
      "id": "destructured-argument",
      "kind": "typed-handoff",
      "operation": "accept",
      "source": "const { body } = { body: $candidate }; accept(body);",
      "receiver": "body"
    },
    {
      "id": "callback-return",
      "kind": "typed-return",
      "operation": "arrow-return",
      "source": "Promise.resolve().then(() => $candidate);"
    },
    {
      "id": "yield-value",
      "kind": "typed-yield",
      "operation": "yield",
      "source": "function* produce() { yield $candidate; }",
      "receiver": "$candidate"
    },
    {
      "id": "array-spread",
      "kind": "typed-spread",
      "operation": "spread",
      "source": "const copy = [...[$candidate]];",
      "receiver": "[$candidate]"
    },
    {
      "id": "object-spread",
      "kind": "typed-spread",
      "operation": "spread-object",
      "source": "const copy = { ...$candidate };",
      "receiver": "$candidate"
    },
    {
      "id": "await-using",
      "kind": "typed-disposal",
      "operation": "await-using",
      "source": "async function consume() { await using owned = $candidate; }",
      "receiver": "$candidate",
      "requires": "async-disposable",
      "inapplicable": "This interface does not declare Symbol.asyncDispose; explicit cancellation, completion and return/handoff remain covered."
    },
    {
      "id": "for-await-factory",
      "kind": "typed-iteration",
      "operation": "for-await",
      "source": "declare function sourceFactory(): Promise<typeof $candidate>; async function consume() { for await (const chunk of await sourceFactory()) void chunk; }",
      "receiver": "await sourceFactory()",
      "requires": "async-iterable",
      "inapplicable": "This family is not a direct async byte iterable; its valid handoffs/event observation remain covered."
    },
    {
      "id": "for-await-assertion",
      "kind": "typed-iteration",
      "operation": "for-await",
      "source": "declare const erased: unknown; async function consume() { for await (const chunk of erased as typeof $candidate) void chunk; }",
      "receiver": "erased as typeof $candidate",
