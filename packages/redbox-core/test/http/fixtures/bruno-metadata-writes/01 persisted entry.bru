meta {
  name: Persist owned translation entry
  type: http
  seq: 1
}
post {
  url: {{host}}/default/rdmp/api/i18n/entries/en/translation/bruno-write
  body: json
  auth: bearer
}
auth:bearer {
  token: {{token}}
}
headers {
  Content-Type: application/json
}
body:json {
  {"value":"Bruno persisted"}
}
tests {
  test("persisted entry", () => { expect(res.status).to.equal(200); expect(res.body.value).to.equal("Bruno persisted"); });
}
