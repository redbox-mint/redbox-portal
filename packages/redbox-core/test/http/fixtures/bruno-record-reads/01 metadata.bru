meta {
 name: Owned persisted metadata
 type: http
 seq: 1
}
get {
 url: {{host}}/default/rdmp/api/records/metadata/read-record?apiVersion=2.0
 body: none
 auth: bearer
}
auth:bearer {
 token: {{token}}
}
tests {
 test("metadata and revision", function () {
  expect(res.status).to.equal(200);
  expect(res.body.data.title).to.equal("read-record");
  expect(res.body.meta.revision).to.equal(0);
 });
}
