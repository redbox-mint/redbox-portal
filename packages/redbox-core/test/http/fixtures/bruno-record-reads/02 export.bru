meta {
 name: Owned scoped export
 type: http
 seq: 2
}
get {
 url: {{host}}/default/rdmp/api/export/record/download/csv?recType=dataRecord
 body: none
 auth: bearer
}
auth:bearer {
 token: {{token}}
}
tests {
 test("scoped CSV", function () {
  expect(res.status).to.equal(200);
  expect(res.body).to.include("read-record");
  expect(res.body).not.to.include("other-record");
 });
}
