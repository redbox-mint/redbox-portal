{
  "name": "@researchdatabox/redbox-core",
  "version": "0.0.1-beta.9022",
  "description": "",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "redbox-loader-templates"
  ],
  "scripts": {
    "test": "TS_NODE_PROJECT=test/tsconfig.json mocha",
    "test:record-contracts": "prettier --check \"scripts/verify-record-contract-coverage.ts\" && npm run typecheck:record-contracts && npm run typecheck:record-schema-tests && TS_NODE_PROJECT=scripts/tsconfig.json node --no-experimental-strip-types -r ts-node/register/transpile-only scripts/verify-record-contract-coverage.ts",
    "test:record-schema-rollout": "npm run test:record-schema-rollout:format && npm run typecheck:record-contracts && npm run test:record-schema-rollout:unit && npm run test:record-schema-rollout:disabled && npm run test:record-schema-rollout:runtime && npm run test:record-schema-rollout:evidence",
    "test:record-schema-rollout:format": "prettier --check \"scripts/verify-record-schema-rollout.ts\" \"test/unit/record-contract/record-schema-rollout-evidence-command.test.ts\" \"test/snapshots/record-schema-shadow-rollout.json\" \"../../test/integration/services/RecordsService.test.ts\"",
    "test:record-schema-rollout:unit": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --require chai --require test/setup.ts --timeout 5000 test/unit/record-contract/record-schema-rollout-evidence-command.test.ts",
    "test:record-schema-rollout:disabled": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --fail-zero --node-option no-experimental-strip-types --require ts-node/register/transpile-only --require chai --require test/setup.ts --timeout 5000 test/services/RecordsService.test.ts --grep \"leaves the non-schema create chain unchanged while record schemas are disabled|preserves baseline update outputs and legacy structural validation while record schemas are disabled|preserves baseline transition outputs and workflow semantics while record schemas are disabled|preserves baseline browser merge and array replacement while record schemas are disabled\"",
    "test:record-schema-rollout:runtime": "npm --prefix ../.. run test:record-schema-rollout:runtime",
    "test:record-schema-rollout:evidence": "TS_NODE_PROJECT=scripts/tsconfig.json node --no-experimental-strip-types -r ts-node/register/transpile-only scripts/verify-record-schema-rollout.ts",
    "build": "rm -rf dist && tsc",
    "lint": "cd ../.. && oxlint packages/redbox-core/src packages/redbox-core/scripts",
    "lint:fix": "cd ../.. && oxlint packages/redbox-core/src packages/redbox-core/scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck:record-contracts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:record-schema-tests": "tsc --noEmit -p test/tsconfig.record-schema.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "generate-openapi": "ts-node --transpile-only scripts/generate-openapi.ts",
    "doc:api": "npm run generate-openapi --",
    "docs:serve": "npx serve ../../../support/docs/generated/api -p 8080"
  },
