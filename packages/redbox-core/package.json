  "scripts": {
    "test": "TS_NODE_PROJECT=test/tsconfig.json mocha",
    "test:record-contracts": "prettier --check \"scripts/verify-record-contract-coverage.ts\" && npm run typecheck:record-contracts && npm run typecheck:record-schema-tests && TS_NODE_PROJECT=scripts/tsconfig.json node --no-experimental-strip-types -r ts-node/register/transpile-only scripts/verify-record-contract-coverage.ts",
    "test:record-schema-rollout": "npm run test:record-schema-rollout:format && npm run typecheck:record-contracts && npm run test:record-schema-rollout:unit && npm run test:record-schema-rollout:disabled && npm run test:record-schema-rollout:runtime && npm run test:record-schema-rollout:evidence",
    "test:record-schema-rollout:format": "prettier --check \"scripts/verify-record-schema-rollout.ts\" \"test/unit/record-contract/record-schema-rollout-evidence-command.test.ts\" \"test/snapshots/record-schema-shadow-rollout.json\" \"../../test/integration/services/RecordsService.test.ts\"",
    "test:record-schema-rollout:unit": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --require chai --require test/setup.ts --timeout 5000 test/unit/record-contract/record-schema-rollout-evidence-command.test.ts",
    "test:record-schema-rollout:disabled": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --fail-zero --node-option no-experimental-strip-types --require ts-node/register/transpile-only --require chai --require test/setup.ts --timeout 5000 test/services/RecordsService.test.ts --grep \"leaves the non-schema create chain unchanged while record schemas are disabled|preserves baseline update outputs and legacy structural validation while record schemas are disabled|preserves baseline transition outputs and workflow semantics while record schemas are disabled|preserves baseline browser merge and array replacement while record schemas are disabled\"",
    "test:record-schema-rollout:runtime": "npm --prefix ../.. run test:record-schema-rollout:runtime",
    "test:record-schema-rollout:evidence": "TS_NODE_PROJECT=scripts/tsconfig.json node --no-experimental-strip-types -r ts-node/register/transpile-only scripts/verify-record-schema-rollout.ts",
    "build": "rm -rf dist && npm run generate:prisma && npm run check:portal-config && tsc && node scripts/prisma-contract.cjs copy",
    "lint": "cd ../.. && oxlint packages/redbox-core/src packages/redbox-core/scripts",
    "lint:fix": "cd ../.. && oxlint packages/redbox-core/src packages/redbox-core/scripts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck:record-contracts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:record-schema-tests": "tsc --noEmit -p test/tsconfig.record-schema.json",
    "typecheck:effect": "tsc --noEmit -p test/tsconfig.effect.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "generate-openapi": "ts-node --transpile-only scripts/generate-openapi.ts",
    "doc:api": "npm run generate-openapi --",
    "docs:serve": "npx serve ../../../support/docs/generated/api -p 8080",
    "typecheck:persistence": "tsc --noEmit -p test/tsconfig.persistence.json",
    "typecheck:application": "tsc --noEmit -p test/tsconfig.application.json",
    "test:application": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 5000 test/application/Application.test.ts",
    "test:application:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 30000 test/application/ApplicationMongo.test.ts",
    "persistence:indexes": "node bin/persistence-indexes.cjs",
    "generate:prisma": "node scripts/prisma-contract.cjs generate",
    "check:prisma": "node scripts/prisma-contract.cjs check",
    "prepack": "npm run check:prisma && npm run build",
    "test:persistence": "bash test/persistence/run.sh",
    "test:persistence-indexes": "npm run test:persistence",
    "test:record-types:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 30000 test/recordTypes/RecordTypesMongo.test.ts",
    "test:http-host": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 10000 test/http/ExpressHost.test.ts",
    "test:sails-record-types:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 30000 test/compat/SailsRecordTypesMongo.test.ts",
    "test:lifecycle:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 30000 test/application/InitializationMongo.test.ts test/queues/QueueMongo.test.ts",
    "test:http-pilot:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 30000 test/http/IdentityMongo.test.ts test/http/MiddlewareMongo.test.ts test/http/RecordTypesMongo.test.ts test/http/PilotFailuresMongo.test.ts test/http/CompiledPilotMongo.test.ts",
    "test:http-bruno:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 45000 test/http/BrunoPilotMongo.test.ts",
    "test:http-configuration:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 45000 test/http/ConfigurationMongo.test.ts",
    "test:http-auth:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 45000 test/http/AuthenticationMongo.test.ts test/http/OidcMongo.test.ts",
    "test:http-csrf:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 45000 test/http/CsrfMongo.test.ts",
    "test:http-pages:mongo": "TS_NODE_PROJECT=test/tsconfig.json mocha --no-config --node-option no-experimental-strip-types --require ts-node/register/transpile-only --timeout 45000 test/http/PagesMongo.test.ts",
    "generate:portal-config": "node scripts/portal-configuration-schema.cjs",
    "check:portal-config": "node scripts/portal-configuration-schema.cjs --check"
  },
