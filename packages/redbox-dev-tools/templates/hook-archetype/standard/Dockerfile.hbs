ARG REDBOX_PORTAL_IMAGE=qcifengineering/redbox-portal:develop-pdfgen

FROM ${REDBOX_PORTAL_IMAGE} AS builder

USER root

COPY . /opt/{{packageName}}

RUN --mount=type=cache,target=/root/.npm \
  cd /opt/{{packageName}} \
  && npm install --include=dev --ignore-scripts --strict-peer-deps \
  && npm run compile \
  && HOOK_TARBALL="$(npm pack --pack-destination /tmp --silent)" \
  && cd /opt/redbox-portal \
  && npm install --legacy-peer-deps --ignore-scripts "/tmp/${HOOK_TARBALL}" \
  && rm -f "/tmp/${HOOK_TARBALL}" \
  && mkdir -p /opt/redbox-portal/views /opt/redbox-portal/assets /opt/redbox-portal/.tmp/public /opt/redbox-portal/language-defaults /opt/redbox-portal/bootstrap-data \
  && if [ -d /opt/{{packageName}}/views ]; then cp -a /opt/{{packageName}}/views/. /opt/redbox-portal/views/; fi \
  && if [ -d /opt/{{packageName}}/assets ]; then cp -a /opt/{{packageName}}/assets/. /opt/redbox-portal/assets/; fi \
  && if [ -d /opt/{{packageName}}/assets ]; then cp -a /opt/{{packageName}}/assets/. /opt/redbox-portal/.tmp/public/; fi \
  && if [ -d /opt/{{packageName}}/language-defaults ]; then cp -a /opt/{{packageName}}/language-defaults/. /opt/redbox-portal/language-defaults/; fi \
  && if [ -d /opt/{{packageName}}/support/bootstrap-data ]; then cp -a /opt/{{packageName}}/support/bootstrap-data/. /opt/redbox-portal/bootstrap-data/; fi

FROM ${REDBOX_PORTAL_IMAGE} AS {{packageName}}
USER root

COPY --from=builder --chown=node:node --chmod='u=rwx,g=rx,o=rx' /opt/redbox-portal /opt/redbox-portal

USER node
