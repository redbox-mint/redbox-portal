networks:
  main:

x-rbportal-env: &rbportal-env
  - NODE_ENV=integrationtest
  - NODE_PATH=/opt/redbox-portal/node_modules:/opt/redbox-portal/node_modules/@researchdatabox/redbox-core/node_modules
  - PORT=1500
  - sails_redbox__apiKey=integration-api-key
  - sails_redbox__mochaTesting=true
  - sails_brandingConfigurationDefaults__auth__local__default__token=integration-token
  - sails_security__csrf=false
  - LOAD_DEFAULT_FORMS=true
  - HOOK_S3_ACCESS_KEY=minioadmin
  - HOOK_S3_SECRET_KEY=minioadmin
  - HOOK_S3_REGION=ap-southeast-2
  - HOOK_S3_BUCKET=test-aws-{{packageName}}-attachments
  - HOOK_S3_ENDPOINT=http://minio:9000
  - HOOK_S3_KEY_PREFIX=attachments/
  - HOOK_ATTACHMENTS_STAGE_DIR=/attachments/staging
  - HOOK_S3_FORCE_PATH_STYLE=true
  - HOOK_S3_SUPPORTS_ACL=false
  - MINIO_WAIT_SECONDS=180
  - REGENERATE_SHIMS=true
  - CI=${CI:-false}
  - RBPORTAL_COVERAGE_DIR=/tmp/redbox-coverage/mocha

x-rbportal-depends: &rbportal-depends
  mongodb:
    condition: service_healthy
  solr:
    condition: service_healthy
  minio:
    condition: service_healthy

services:
  redboxportal:
    build:
      context: ../..
      dockerfile: Dockerfile
      target: {{packageName}}
    ports:
      - "1500:1500"
    volumes:
      - "../../language-defaults:/opt/redbox-portal/language-defaults"
      - "../../support/bootstrap-data:/opt/redbox-portal/bootstrap-data:ro"
      - "../../support/prepare-minio.sh:/opt/redbox-portal/support/prepare-minio.sh:ro"
      - "../../support/integration-testing:/opt/redbox-portal/support/integration-testing:ro"
      - "../../tsconfig.json:/opt/redbox-portal/tsconfig.json:ro"
      - "../../test/integration:/opt/redbox-portal/test/integration/{{integrationDirName}}"
      - "./.tmp/attachments/staging:/attachments/staging"
    depends_on: *rbportal-depends
    expose:
      - "1500"
    environment: *rbportal-env
    networks:
      main:
        aliases:
          - redboxportal
    init: true
    entrypoint:
      - bash
      - /opt/redbox-portal/support/integration-testing/run-mocha-hook.sh

  mongodb:
    image: mongo:7
    networks:
      main:
        aliases:
          - mongodb
    ports:
      - "27017:27017"
    healthcheck:
      test: ['CMD-SHELL', "echo 'db.runCommand(\"ping\").ok' | mongosh"]
      interval: '10s'
      timeout: '5s'
      retries: 10
      start_period: '30s'

  solr:
    image: solr:8.11.1
    expose:
      - "8983"
    ports:
      - "8983:8983"
    healthcheck:
      test: ['CMD-SHELL', 'curl http://localhost:8983']
      interval: '10s'
      timeout: '5s'
      retries: 10
      start_period: '30s'
    networks:
      main:
        aliases:
          - solr
    entrypoint:
      - docker-entrypoint.sh
      - solr-precreate
      - redbox

  minio:
    image: minio/minio:latest
    command: server /data --console-address ":9001"
    networks:
      main:
        aliases:
          - minio
    expose:
      - "9000"
      - "9001"
    environment:
      - MINIO_ROOT_USER=minioadmin
      - MINIO_ROOT_PASSWORD=minioadmin
    healthcheck:
      test: [ 'CMD-SHELL', 'curl -fsS http://localhost:9000/minio/health/ready' ]
      interval: '5s'
      timeout: '5s'
      retries: 20
      start_period: '10s'
